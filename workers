      method:"POST", headers:{"content-type":"application/json"},
      body: JSON.stringify({ token: token })
    });
    var data = await res.json();
    if (!data.ok){ showNg(data.error || "時間切れの可能性があります"); return; }
    showOk(data.code || "------", data.hours || "");
  } catch(e){
    showNg("通信に失敗しました");
  }
})();
