function isChibaSection(sec) {
  return String(sec || "").indexOf("千葉大") >= 0;
}

function chibaDefault(kind) {
  return kind === "jutsushiki" ? CHIBA_JUTSU_DEFAULT : CHIBA_BYOMEI_DEFAULT;
}

function chibaKindOk(kind) {
  return kind === "byomei" || kind === "jutsushiki";
}

function chibaLabel(kind) {
  return kind === "jutsushiki" ? "術式" : "病名";
}

// KVに登録があればそれを、無ければコード内蔵の初期値を使う
async function getChibaList(env, kind) {
  if (env && env.FORM_KV) {
    try {
      const raw = await env.FORM_KV.get(CHIBA_KEYS[kind], { cacheTtl: 300 });
      if (raw) {
        const obj = JSON.parse(raw);
        const rows = Array.isArray(obj.rows) ? obj.rows : null;
        if (rows && rows.length) return rows;
      }
    } catch (e) {
      // 壊れていたら初期値に落とす
    }
  }
  return chibaDefault(kind);
}

// Excelから来た行を整える。空行を捨て、同じ名前は1つにまとめる
function normalizeChibaRows(rows) {
  const out = [];
  const seen = new Set();
  for (const r of rows || []) {
    const cell = Array.isArray(r) ? r[0] : r;
    const v = (cell == null) ? "" : String(cell).trim();
    if (!v) continue;
    if (seen.has(v)) continue;
    seen.add(v);
    out.push(v);
  }
  return out;
}

