async function saveReport(env, body, authUser) {
  if (!env.opecopy_db) return jsonError("D1バインディング opecopy_db が設定されていません", 500);
  const b = body || {};
  const text = String(b.body || "").trim();
  if (!text) return jsonError("報告の内容を入力してください", 400);
  if (text.length > 2000) return jsonError("報告は2000文字までにしてください", 400);
  const now = new Date().toISOString();
  await env.opecopy_db.prepare(
    "INSERT INTO reports (created_at, created_by, master_id, master_name, body, status) VALUES (?,?,?,?,?,'new')"
  ).bind(now, String(authUser || ""), b.master_id || null, b.master_name || null, text).run();
  return jsonOk({ saved: true });
}

async function purgeOldReports(env) {
  const limit = new Date(Date.now() - REPORT_KEEP_DAYS * 86400000).toISOString();
  try {
    await env.opecopy_db.prepare("DELETE FROM reports WHERE created_at < ?").bind(limit).run();
  } catch (e) {
    // 消せなくても一覧の表示は続ける
  }
}

async function listReports(env) {
  if (!env.opecopy_db) return jsonError("D1バインディング opecopy_db が設定されていません", 500);
  await purgeOldReports(env);
  const rs = await env.opecopy_db.prepare(
    "SELECT * FROM reports ORDER BY (status='new') DESC, id DESC LIMIT 200"
  ).all();
  return jsonOk({ reports: (rs && rs.results) || [], keepDays: REPORT_KEEP_DAYS });
}

async function markReport(env, body) {
