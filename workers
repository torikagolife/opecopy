async function runChibaPick(){
  var q = $("cbQuery").value.trim();
  if (!q){ $("cbList").innerHTML = '<div class="hint">記載を入れてね</div>'; return; }
  $("cbList").innerHTML = '<div class="hint"><span class="spin"></span> 検索中…</div>';
  try {
    var data = await api("/api/chiba/match", {
      method:"POST", headers:{"content-type":"application/json"},
      body: JSON.stringify({ kind: cbKind, query: q })
    });
    var rs = data.results || [];
    if (!rs.length){ $("cbList").innerHTML = '<div class="hint">候補が見つかりませんでした</div>'; return; }
    var h = "";
    for (var i=0;i<rs.length;i++){
      h += '<div class="kcrow" data-pick="' + i + '">' +
             '<div class="kcname">' + esc(rs[i].name) + '</div>' +
             (rs[i].reason ? '<div class="kcreason">' + esc(rs[i].reason) + '</div>' : '') +
           '</div>';
    }
    $("cbList").innerHTML = h;
    var rows = $("cbList").querySelectorAll(".kcrow");
    for (var j=0;j<rows.length;j++){
      rows[j].addEventListener("click", function(ev){
        var idx = parseInt(ev.currentTarget.getAttribute("data-pick"),10);
        results[cbTargetNo] = rs[idx].name;
        $("cbModal").classList.add("hidden");
        renderResults();
        toast("反映しました");
      });
    }
  } catch(e){
    $("cbList").innerHTML = '<div class="hint">検索に失敗: ' + esc(e.message) + '</div>';
  }
}
