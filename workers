async function loadMe(){
  try {
    var r = await api("/api/whoami");
    if (r.user) $("meBox").textContent = r.user + " でログイン中";
  } catch(e){}
}

async function doLogout(){
  if (!confirm("ログアウトします。よろしい？")) return;
  try { await api("/api/logout", { method:"POST" }); } catch(e){}
  try { localStorage.removeItem("ope_sess_tok"); } catch(e){}
  location.href = "/login";
}

async function sendReport(){
  var t = $("rpBody").value.trim();
  if (!t){ alert("報告の内容を書いてください"); return; }
  var b = $("rpSend");
  b.disabled = true; b.textContent = "送信中…";
  try {
    await api("/api/report", {
      method:"POST", headers:{"content-type":"application/json"},
      body: JSON.stringify({
        body: t,
        master_id: curMaster ? (curMaster.id || "") : "",
        master_name: curMaster ? (curMaster.name || "") : ""
      })
    });
    toast("報告を送りました。ありがとう！");
    $("rpBody").value = "";
    $("rpModal").classList.add("hidden");
  } catch(e){
    alert("送信に失敗: " + e.message);
  } finally {
    b.disabled = false; b.textContent = "\uD83D\uDCE4 送る";
  }
}

