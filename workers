// ============================================================
var masters = [];
var curMaster = null;     // 抽出後に確定するマスタ本体
var pages = [];           // {pdfPage|img, role:"rec"|"mat"|"skip", num}
var pdfDoc = null;
var currentRecordId = null;   // 保存中の台帳レコードid(新規読み取りで null に戻す)
var currentFileHash = "";     // 読み込んだPDFの指紋。同じファイルなら台帳の同じ行を使い回す
var results = {};         // no -> 値
var labels = [];          // 確定した材料シール
var labelObs = [];        // 各タイルからの生の観測(多数決の材料)
var usedTokens = 0;       // 今回使ったトークン合計
var disagree = {};        // 複数回の読み取りが一致しなかった項目 no -> [候補...]
var failedShots = 0;      // 読み取りに失敗した領域の数
var assignMap = {};       // no -> [labelIndex,...]

var TYPE_ICON = { ocr:"\uD83D\uDD0D", choice:"☑️", fixed:"\uD83D\uDCCC", sticker:"\uD83C\uDFF7️", confirm:"❓", unset:"⬜" };

// ============================================================
// ユーティリティ
// ============================================================
function $(id){ return document.getElementById(id); }
function esc(s){
  return String(s == null ? "" : s)
    .replace(/&/g,"&amp;").replace(/</g,"&lt;")
    .replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}
var NL = String.fromCharCode(10);

function toast(msg){
  var t = $("toast");
  t.textContent = msg;
  t.classList.add("show");
  setTimeout(function(){ t.classList.remove("show"); }, 2200);
}

async function api(path, opt){
  opt = opt || {};
  var h = {};
  if (opt.headers){ for (var k in opt.headers) h[k] = opt.headers[k]; }
  var t = getToken();
  if (t) h["x-ope-auth"] = t;
  var q = getQrToken();
  if (q) h["x-ope-qr"] = q;
  var st = getSessTok();
  if (st) h["x-ope-sess"] = st;      // Cookieが送れない環境の保険
  opt.headers = h;
  var res = await fetch(path, opt);
  if (res.status === 401){
    var body = null;
    try { body = await res.json(); } catch(e){}
    var msg = (body && body.error) || "";
    if (msg.indexOf("QR") >= 0){        // スマホ承認が切れた場合はQRから出し直す
      clearQrToken();
      startQrGate();
      throw new Error(msg);
    }
    clearToken(); showLogin();
    throw new Error("認証が必要です");
  }
  var data = await res.json();
  if (!data.ok) throw new Error(data.error || "APIエラー");
  return data;
}

function copyText(s){
  if (navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(s).then(function(){ toast("コピーしました"); },
      function(){ fallbackCopy(s); });
  } else fallbackCopy(s);
}
function fallbackCopy(s){
  var ta = document.createElement("textarea");
  ta.value = s;
  ta.style.position = "fixed"; ta.style.opacity = "0";
  document.body.appendChild(ta); ta.select();
  try { document.execCommand("copy"); toast("コピーしました"); }
  catch(e){ toast("コピーに失敗しました"); }
  document.body.removeChild(ta);
}

// ============================================================
// pdf.js
// ============================================================
var pdfJsLoading = null;
function ensurePdfJs(){
  if (window.pdfjsLib) return Promise.resolve();
  if (pdfJsLoading) return pdfJsLoading;
  pdfJsLoading = new Promise(function(resolve, reject){
    var s = document.createElement("script");
    s.src = "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js";
    s.onload = function(){
      window.pdfjsLib.GlobalWorkerOptions.workerSrc =
        "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";
      resolve();
    };
    s.onerror = function(){ pdfJsLoading = null; reject(new Error("PDFライブラリの読み込みに失敗しました")); };
    document.head.appendChild(s);
  });
  return pdfJsLoading;
}

