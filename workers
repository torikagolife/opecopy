// 千葉大フォームの入力作業
//   読み取り済みの症例から千葉大用の項目だけを取り出して並べる。
//   担当者はここを上から順に潰していけばよい。
// ============================================================
var cwDoneMode = false;

function recShowTab(chiba){
  $("recPaneAll").classList.toggle("hidden", chiba);
  $("recPaneChiba").classList.toggle("hidden", !chiba);
  $("recTabAll").className = "btn" + (chiba ? "" : " primary");
  $("recTabChiba").className = "btn" + (chiba ? " primary" : "");
  if (chiba) loadChibaWork();
}

async function loadChibaWork(){
  $("cwBody").innerHTML = '<div class="empty">読込中…</div>';
  var p = [];
  p.push("done=" + (cwDoneMode ? "1" : "0"));
  var fr = $("cwFrom").value, to = $("cwTo").value;
  if (fr) p.push("from=" + encodeURIComponent(fr.replace(/-/g, "/")));
  if (to) p.push("to=" + encodeURIComponent(to.replace(/-/g, "/")));
  try {
    var r = await api("/api/chiba/work?" + p.join("&"));
    var rs = r.records || [];
    $("cwCount").textContent = rs.length ? (rs.length + " 件") : "";
    if (!rs.length){
      $("cwBody").innerHTML = '<div class="empty">' +
        (cwDoneMode ? "入力済みの症例はありません" : "入力待ちの症例はありません \uD83C\uDF89") + '</div>';
      return;
    }
    var h = "";
    for (var i=0;i<rs.length;i++){
      var x = rs[i];
      h += '<div style="border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:10px;background:#fff">' +
           '<div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:8px">' +
             '<b>症例 #' + esc(x.id) + '</b>' +
             '<span>患者ID ' + esc(x.patient_no || "-") + '</span>' +
             '<span>' + esc(x.surgery_date || "-") + '</span>' +
             '<span style="color:#8a919c;font-size:12px">' + esc(x.master_name || "") +
               (x.updated_by ? "／読取 " + esc(x.updated_by) : "") + '</span>' +
             '<span style="margin-left:auto">' +
               '<button class="btn mini" data-cwcopy="' + i + '">\uD83D\uDCCB まとめてコピー</button> ' +
               (cwDoneMode
                 ? '<button class="btn mini" data-cwundo="' + esc(x.id) + '">↩ 未入力に戻す</button>'
                 : '<button class="btn mini teal" data-cwok="' + esc(x.id) + '">\u2705 入力済みにする</button>') +
             '</span>' +
           '</div>';
      var fs = x.fields || [];
      if (!fs.length){
        h += '<div class="hint">千葉大用の項目がありません</div>';
      } else {
        h += '<table class="list"><tr><th style="width:34%">項目</th><th>値</th><th style="width:56px"></th></tr>';
        for (var j=0;j<fs.length;j++){
          h += '<tr><td>' + esc(fs[j].label) + '</td>' +
               '<td>' + (fs[j].value ? esc(fs[j].value) : '<span style="color:#c9821a">（空）</span>') + '</td>' +
               '<td><button class="btn mini" data-cwv="' + i + '-' + j + '">\uD83D\uDCCB</button></td></tr>';
        }
        h += '</table>';
      }
      if (cwDoneMode && x.chiba_at){
        h += '<div class="hint" style="margin-top:6px">入力済み: ' + esc(recFmt(x.chiba_at)) + '</div>';
      }
      h += '</div>';
    }
    $("cwBody").innerHTML = h;

    // 1項目コピー
    var vs = $("cwBody").querySelectorAll("button[data-cwv]");
    for (var a=0;a<vs.length;a++){
      vs[a].addEventListener("click", function(ev){
        var t = ev.currentTarget.getAttribute("data-cwv").split("-");
        var f = rs[Number(t[0])].fields[Number(t[1])];
        copyText(f ? f.value : "");
      });
    }
    // まとめてコピー
    var cps = $("cwBody").querySelectorAll("button[data-cwcopy]");
    for (var b=0;b<cps.length;b++){
      cps[b].addEventListener("click", function(ev){
        var x = rs[Number(ev.currentTarget.getAttribute("data-cwcopy"))];
        var lines = [];
        for (var k=0;k<(x.fields||[]).length;k++){
          lines.push(x.fields[k].label + ": " + (x.fields[k].value || ""));
