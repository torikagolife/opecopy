function esc(s){
  return String(s == null ? "" : s)
    .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}

// URLから鍵を取り出す
var token = "";
(function(){
  var q = location.search || "";
  var i = q.indexOf("t=");
  if (i >= 0){
    var raw = q.slice(i+2).split("&")[0].toLowerCase();
    var out = "";
    for (var k=0;k<raw.length && out.length<64;k++){
      var c = raw.charAt(k);
      if ((c>="0"&&c<="9")||(c>="a"&&c<="f")) out += c;
    }
    token = out;
  }
