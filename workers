async function listMasters(env) {
  const res = await env.FORM_KV.list({ prefix: KV_PREFIX });
  const masters = [];
  for (const k of res.keys) {
    const id = k.name.slice(KV_PREFIX.length);
    const m = k.metadata || {};
    masters.push({
      id,
      name: m.name || id,
      count: typeof m.count === "number" ? m.count : null,
      stickerTodo: typeof m.stickerTodo === "number" ? m.stickerTodo : null,
      updatedAt: m.updatedAt || null,
    });
  }
  masters.sort((a, b) => String(a.name).localeCompare(String(b.name), "ja"));
  return jsonOk({ masters });
}

async function getMaster(env, id) {
  const clean = sanitizeId(id || "");
  if (!clean) return jsonError("idが不正です", 400);
  const raw = await env.FORM_KV.get(KV_PREFIX + clean);
  if (!raw) return jsonError("マスタが見つかりません: " + clean, 404);
  let obj;
  try {
    obj = JSON.parse(raw);
  } catch (e) {
    return jsonError("マスタJSONが壊れています: " + clean, 500);
  }
  return jsonOk({ master: obj });
}

async function saveMaster(env, body) {
  const id = sanitizeId((body && body.id) || "");
  if (!id) return jsonError("idが不正です(半角英数字・ハイフン・アンダースコアのみ)", 400);

  const name = String((body && body.name) || "").trim() || id;
  const rawItems = Array.isArray(body && body.items) ? body.items : [];

  // 正規化(不要フィールドを落として型ごとに整形。noは並び順で振り直し)
  const items = [];
  for (let i = 0; i < rawItems.length; i++) {
    const src = rawItems[i] || {};
    const label = String(src.label || "").trim();
    if (!label) continue; // ラベル空は捨てる
    const type = normalizeType(src.type);
    const it = {
      no: items.length + 1,
      section: String(src.section || "").trim(),
      label,
      type,
    };
    if (type === "fixed") {
      it.value = String(src.value || "").trim();
    }
    if (type === "choice") {
      it.choices = toArray(src.choices);
    }
    if (type === "ocr" || type === "choice") {
      const kw = String(src.keyword || "").trim();
      const rl = String(src.rule || "").trim();
      if (kw) it.keyword = kw;
      if (rl) it.rule = rl;
      const sg = String(src.suggest || "").trim();
      if (sg === "kcode" || sg === "doctor" || sg === "icd10" ||
          sg === "chiba-byomei" || sg === "chiba-jutsushiki") it.suggest = sg;   // 候補リストを出す項目
    }
    if (type === "sticker") {
      it.source = "label";
      it.matKeywords = toArray(src.matKeywords);
      it.ngKeywords = toArray(src.ngKeywords);
    }
    items.push(it);
  }

  if (!items.length) return jsonError("項目が1つもありません", 400);

  const master = {
    id,
    name,
    updatedAt: new Date().toISOString(),
    items,
  };

  let stickerTodo = 0;
  for (const it of items) {
    if (it.type === "sticker" && (!it.matKeywords || !it.matKeywords.length)) stickerTodo++;
  }

  await env.FORM_KV.put(KV_PREFIX + id, JSON.stringify(master), {
    metadata: {
      name: master.name,
      count: items.length,
      stickerTodo,
      updatedAt: master.updatedAt,
    },
  });

  return jsonOk({ master, stickerTodo });
}

async function deleteMaster(env, body) {
  const id = sanitizeId((body && body.id) || "");
  if (!id) return jsonError("idが不正です", 400);
  await env.FORM_KV.delete(KV_PREFIX + id);
  return jsonOk({ deleted: id });
}

