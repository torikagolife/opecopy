async function openEdit(id){
  try {
    var data = await api("/api/master?id=" + encodeURIComponent(id));
    cur = data.master;
    if (!cur.items) cur.items = [];
    curIsNew = false;
    showEdit();
  } catch(e){ alert("読込に失敗: " + e.message); }
}

function newMaster(){
  var name = prompt("マスタ名（例: TKA（人工膝関節））", "");
  if (name === null) return;
  name = String(name).trim();
  if (!name) return;
  cur = { id: autoId(name), name: name, items: [] };
  curIsNew = true;
  showEdit();
}

function showEdit(){
  $("listView").classList.add("hidden");
  $("editView").classList.remove("hidden");
  $("mName").value = cur.name || "";
  $("mId").value = cur.id || "";
  renderItems();
  window.scrollTo(0,0);
}

function showList(){
  $("editView").classList.add("hidden");
  $("listView").classList.remove("hidden");
  cur = null;
  loadList();
}

function renderItems(){
  var items = cur.items;
  var stickerTodo = 0, byType = {};
  for (var i=0;i<items.length;i++){
    var t = items[i].type || "unset";
    byType[t] = (byType[t]||0) + 1;
    if (t === "sticker" && splitList(items[i].matKeywords).length === 0) stickerTodo++;
  }
  var stat = "全 " + items.length + " 項目";
  for (var k=0;k<TYPES.length;k++){
    var code = TYPES[k][0];
    if (byType[code]) stat += " ／ " + TYPES[k][1] + " " + byType[code];
  }
  if (stickerTodo > 0) stat += '　<span class="todo">材料キーワード未設定 ' + stickerTodo + '件</span>';
  $("mStat").innerHTML = stat;

  var h = "";
  var lastSection = null;
  for (var n=0;n<items.length;n++){
    var it = items[n];
    var sec = it.section || "";
    if (sec !== lastSection){
      h += '<div class="secline">' + (sec ? esc(sec) : "（セクションなし）") + '</div>';
      lastSection = sec;
    }
    h += itemCard(it, n, items.length);
  }
  $("itemsBody").innerHTML = h;
  wireItems();
}

function itemCard(it, idx, total){
  var type = it.type || "unset";
  var h = '<div class="item" draggable="true" data-idx="' + idx + '">';

  // 1段目: 並び替え / 番号 / セクション / 項目名 / 削除
  h += '<div class="irow">';
  h += '<span class="grip" title="ドラッグで並び替え">⠿</span>';
  h += '<span class="num">#' + (idx+1) + '</span>';
  h += '<button class="btn mini" data-mv="up" data-idx="' + idx + '"' + (idx===0?" disabled":"") + '>▲</button>';
  h += '<button class="btn mini" data-mv="down" data-idx="' + idx + '"' + (idx===total-1?" disabled":"") + '>▼</button>';
  h += '<div class="fld w150"><label>セクション</label>' +
       '<input type="text" class="w150" data-f="section" data-idx="' + idx + '" value="' + esc(it.section||"") + '" placeholder="基本項目"></div>';
  h += '<div class="fld grow"><label>項目名（JOANRの欄名）</label>' +
       '<input type="text" data-f="label" data-idx="' + idx + '" value="' + esc(it.label||"") + '"></div>';
  h += '<div class="fld"><label>種別</label><select class="w120" data-f="type" data-idx="' + idx + '">';
  for (var i=0;i<TYPES.length;i++){
    h += '<option value="' + TYPES[i][0] + '"' + (TYPES[i][0]===type?" selected":"") + '>' + TYPES[i][1] + '</option>';
  }
  h += '</select></div>';
  h += '<button class="btn mini danger" data-del="' + idx + '">\uD83D\uDDD1</button>';
  h += '</div>';

  // 2段目: 種別ごとの入力欄
  var second = "";
  if (type === "ocr" || type === "choice"){
    second += '<div class="fld"><label>候補リスト</label><select class="w150" data-f="suggest" data-idx="' + idx + '">' +
      '<option value=""' + (it.suggest ? "" : " selected") + '>なし</option>' +
      '<option value="kcode"' + (it.suggest === "kcode" ? " selected" : "") + '>\uD83D\uDD0D 登録術式(Kコード)</option>' +
      '<option value="icd10"' + (it.suggest === "icd10" ? " selected" : "") + '>\uD83E\uDE7A 病名(ICD-10・AI推定)</option>' +
      '<option value="chiba-byomei"' + (it.suggest === "chiba-byomei" ? " selected" : "") + '>\uD83C\uDFEB 千葉大リスト(病名)</option>' +
      '<option value="chiba-jutsushiki"' + (it.suggest === "chiba-jutsushiki" ? " selected" : "") + '>\uD83C\uDFEB 千葉大リスト(術式)</option>' +
      '<option value="doctor"' + (it.suggest === "doctor" ? " selected" : "") + '>\uD83D\uDC68‍⚕️ 医師マスタ</option>' +
      '</select></div>';
  }
  if (type === "ocr"){
    second += '<div class="fld w150"><label>読取り文字（用紙上のラベル）</label>' +
      '<input type="text" class="w150" data-f="keyword" data-idx="' + idx + '" value="' + esc(it.keyword||"") + '" placeholder="施行術式"></div>';
    second += '<div class="fld grow"><label>抽出ルール</label>' +
      '<input type="text" data-f="rule" data-idx="' + idx + '" value="' + esc(it.rule||"") + '" placeholder="右側 / 3番目の時間 / ○で判断"></div>';
  } else if (type === "choice"){
    second += '<div class="fld w150"><label>読取り文字</label>' +
      '<input type="text" class="w150" data-f="keyword" data-idx="' + idx + '" value="' + esc(it.keyword||"") + '"></div>';
    second += '<div class="fld grow"><label>選択肢（カンマ区切り）</label>' +
      '<input type="text" data-f="choices" data-idx="' + idx + '" value="' + esc(splitList(it.choices).join(",")) + '" placeholder="左,右"></div>';
    second += '<div class="fld grow"><label>抽出ルール</label>' +
      '<input type="text" data-f="rule" data-idx="' + idx + '" value="' + esc(it.rule||"") + '" placeholder="○で判断"></div>';
  } else if (type === "fixed"){
    second += '<div class="fld grow"><label>固定値（OCRせずこの値を出す）</label>' +
      '<input type="text" data-f="value" data-idx="' + idx + '" value="' + esc(it.value||"") + '" placeholder="入院手術"></div>';
  } else if (type === "sticker"){
    var kws = splitList(it.matKeywords);
    var ngs = splitList(it.ngKeywords);
    second += '<div class="fld grow"><label>材料キーワード（カンマ区切り／製品名から この材料を特定する語。語は長めに）</label>' +
      '<input type="text" data-f="matKeywords" data-idx="' + idx + '" value="' + esc(kws.join(",")) + '" placeholder="Bone Cement,Endurance,Palacos"></div>';
    second += '<div class="fld grow"><label>除外キーワード（この語を含むシールは除く）</label>' +
      '<input type="text" data-f="ngKeywords" data-idx="' + idx + '" value="' + esc(ngs.join(",")) + '" placeholder="Plug,CEMENTED"></div>';
  }
  if (second) h += '<div class="irow second">' + second + '</div>';

  if (type === "sticker" && splitList(it.matKeywords).length === 0){
    h += '<div class="warn">⚠️ 材料キーワード未設定 — このままだとシールの自動割当ができません</div>';
  }

  h += '</div>';
  return h;
}

function wireItems(){
  var body = $("itemsBody");

  // 入力（再描画せず値だけ反映＝入力中にフォーカスが飛ばない）
  var ins = body.querySelectorAll("input[data-f]");
  for (var i=0;i<ins.length;i++){
    ins[i].addEventListener("input", function(ev){
      var el = ev.currentTarget;
      var idx = parseInt(el.getAttribute("data-idx"),10);
      var f = el.getAttribute("data-f");
      if (f === "choices" || f === "matKeywords" || f === "ngKeywords") cur.items[idx][f] = splitList(el.value);
      else cur.items[idx][f] = el.value;
    });
  }
  // セクション変更は見出しが変わるので、離れた時だけ再描画
  var secs = body.querySelectorAll('input[data-f="section"]');
  for (var s=0;s<secs.length;s++){
    secs[s].addEventListener("change", function(){ renderItems(); });
  }
  // 種別変更 → 入力欄が変わるので再描画
  var sels = body.querySelectorAll("select[data-f]");
  for (var j=0;j<sels.length;j++){
    sels[j].addEventListener("change", function(ev){
      var el = ev.currentTarget;
      var idx = parseInt(el.getAttribute("data-idx"),10);
      var f = el.getAttribute("data-f");
      if (f === "suggest"){ cur.items[idx].suggest = el.value; return; }   // 入力欄は変わらないので再描画しない
      cur.items[idx].type = el.value;
      renderItems();
    });
  }
  // ▲▼
  var mvs = body.querySelectorAll("button[data-mv]");
  for (var m=0;m<mvs.length;m++){
    mvs[m].addEventListener("click", function(ev){
      var el = ev.currentTarget;
      var idx = parseInt(el.getAttribute("data-idx"),10);
      var dir = el.getAttribute("data-mv") === "up" ? -1 : 1;
      moveItem(idx, idx + dir);
    });
  }
  // 削除
  var dels = body.querySelectorAll("button[data-del]");
  for (var d=0;d<dels.length;d++){
    dels[d].addEventListener("click", function(ev){
      var idx = parseInt(ev.currentTarget.getAttribute("data-del"),10);
      if (!confirm("「" + (cur.items[idx].label || "この項目") + "」を削除しますか？")) return;
      cur.items.splice(idx,1);
      renderItems();
    });
  }
  // ドラッグ並び替え
  var cards = body.querySelectorAll(".item");
  for (var c=0;c<cards.length;c++){
    cards[c].addEventListener("dragstart", function(ev){
      dragFrom = parseInt(ev.currentTarget.getAttribute("data-idx"),10);
      ev.currentTarget.classList.add("drag");
      if (ev.dataTransfer) ev.dataTransfer.effectAllowed = "move";
    });
    cards[c].addEventListener("dragend", function(ev){
      ev.currentTarget.classList.remove("drag");
      var os = body.querySelectorAll(".item.over");
      for (var q=0;q<os.length;q++) os[q].classList.remove("over");
    });
    cards[c].addEventListener("dragover", function(ev){
      ev.preventDefault();
      ev.currentTarget.classList.add("over");
    });
    cards[c].addEventListener("dragleave", function(ev){
      ev.currentTarget.classList.remove("over");
    });
    cards[c].addEventListener("drop", function(ev){
      ev.preventDefault();
      var to = parseInt(ev.currentTarget.getAttribute("data-idx"),10);
      ev.currentTarget.classList.remove("over");
      if (dragFrom >= 0 && dragFrom !== to) moveItem(dragFrom, to);
      dragFrom = -1;
    });
  }
}

function moveItem(from, to){
  if (from < 0 || from >= cur.items.length) return;
  if (to   < 0 || to   >= cur.items.length) return;
  var it = cur.items.splice(from,1)[0];
  cur.items.splice(to,0,it);
  renderItems();
}

function addItem(){
  var lastSec = cur.items.length ? (cur.items[cur.items.length-1].section || "") : "";
  cur.items.push({ section:lastSec, label:"", type:"unset" });
  renderItems();
  var body = $("itemsBody");
  var ins = body.querySelectorAll('input[data-f="label"]');
  if (ins.length) ins[ins.length-1].focus();
  window.scrollTo(0, document.body.scrollHeight);
}

async function saveMaster(){
  cur.name = $("mName").value.trim();
  var id = sanitizeId($("mId").value);
  if (!cur.name){ alert("マスタ名を入れてね"); return; }
  if (!id){ alert("IDは半角英数字で入れてね"); return; }
  if (!cur.items.length){ alert("項目が空だよ"); return; }

  var noLabel = 0;
  for (var i=0;i<cur.items.length;i++){ if (!String(cur.items[i].label||"").trim()) noLabel++; }
  if (noLabel){
    if (!confirm("項目名が空の行が " + noLabel + " 件あります。保存時に削除されますが良い？")) return;
  }
  cur.id = id;

  var btn = $("btnSave");
  btn.disabled = true; btn.textContent = "⏳ 保存中…";
  try {
    var data = await api("/api/master", {
      method:"POST", headers:{"content-type":"application/json"},
      body: JSON.stringify({ id: cur.id, name: cur.name, items: cur.items })
    });
    cur = data.master;
    curIsNew = false;
    renderItems();
    var msg = "保存しました";
    if (data.stickerTodo > 0) msg += "（材料キーワード未設定 " + data.stickerTodo + "件）";
    toast(msg);
  } catch(e){
    alert("保存に失敗: " + e.message);
  } finally {
    btn.disabled = false; btn.textContent = "\uD83D\uDCBE 保存";
  }
}

