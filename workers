async function loadList(){
  $("listBody").innerHTML = '<div class="empty"><span class="spin"></span> 読込中…</div>';
  try {
    var data = await api("/api/masters");
    renderList(data.masters || []);
  } catch(e){
    $("listBody").innerHTML = '<div class="empty">読込に失敗: ' + esc(e.message) + '</div>';
  }
}

function renderList(masters){
  if (!masters.length){
    $("listBody").innerHTML =
      '<div class="empty">まだマスタがありません。<br>「\uD83D\uDCE5 Excelから取込」でTSARSAのシートを読ませるのが早いよ。</div>';
    return;
  }
  var h = '<table class="list"><thead><tr>' +
          '<th>マスタ名</th><th>ID</th><th>項目数</th><th>更新</th><th style="width:220px"></th>' +
          '</tr></thead><tbody>';
  for (var i=0;i<masters.length;i++){
    var m = masters[i];
    var badge = "";
    if (m.stickerTodo > 0) badge = '<span class="todo">材料KW未設定 ' + m.stickerTodo + '</span>';
    else if (m.stickerTodo === 0) badge = '<span class="okbadge">材料KW OK</span>';
    h += '<tr>' +
      '<td><span class="mname">' + esc(m.name) + '</span>' + badge + '</td>' +
      '<td class="mid">' + esc(m.id) + '</td>' +
      '<td>' + (m.count == null ? "-" : m.count) + '</td>' +
      '<td class="mid">' + esc(fmtDate(m.updatedAt)) + '</td>' +
      '<td>' +
        '<button class="btn mini" data-act="edit" data-id="' + esc(m.id) + '">✏️ 編集</button> ' +
        '<button class="btn mini" data-act="copy" data-id="' + esc(m.id) + '">\uD83D\uDCD1 複製</button> ' +
        '<button class="btn mini danger" data-act="del" data-id="' + esc(m.id) + '">\uD83D\uDDD1 削除</button>' +
      '</td></tr>';
  }
  h += '</tbody></table>';
  $("listBody").innerHTML = h;

  var btns = $("listBody").querySelectorAll("button[data-act]");
  for (var j=0;j<btns.length;j++){
    btns[j].addEventListener("click", onListAction);
  }
}

async function onListAction(ev){
  var b = ev.currentTarget;
  var act = b.getAttribute("data-act");
  var id  = b.getAttribute("data-id");
  if (act === "edit") return openEdit(id);
  if (act === "copy") return copyMaster(id);
  if (act === "del")  return deleteMaster(id);
}

async function deleteMaster(id){
  if (!confirm("「" + id + "」を削除します。よろしい？")) return;
  try {
    await api("/api/master/delete", {
      method:"POST", headers:{"content-type":"application/json"},
      body: JSON.stringify({ id: id })
    });
    toast("削除しました");
    loadList();
  } catch(e){ alert("削除に失敗: " + e.message); }
}

async function copyMaster(id){
  try {
    var data = await api("/api/master?id=" + encodeURIComponent(id));
    var src = data.master;
    var newName = prompt("複製後のマスタ名", src.name + " のコピー");
    if (newName === null) return;
    newName = String(newName).trim();
    if (!newName) return;
    var newId = prompt("複製後のID（半角英数字）", sanitizeId(src.id + "-copy"));
    if (newId === null) return;
    newId = sanitizeId(newId);
    if (!newId){ alert("IDが不正です"); return; }

    cur = { id:newId, name:newName, items: JSON.parse(JSON.stringify(src.items || [])) };
    curIsNew = true;
    showEdit();
    toast("複製しました（未保存）");
  } catch(e){ alert("複製に失敗: " + e.message); }
}

