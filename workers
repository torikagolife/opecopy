// ▼▼ モデルを変えたいときはここ ▼▼
//  【重要】画像を扱う場合、gpt-4o-mini は "安くない"。
//   miniは画像を約33倍のトークンとして数える(単価が1/33なので金額はほぼ同じ)。
//   A4スキャン1枚 high detail の実測概算:
//       gpt-4o      →  約 1,100 トークン / $0.0028
//       gpt-4o-mini → 約 36,800 トークン / $0.0055
//   TPM(1分あたりトークン数)の上限は金額ではなくトークン数で効くため、
//   miniだと画像5枚ほどで 200,000 TPM に達して 429 が出る。
//   → 画像主体の本ツールでは gpt-4o の方が「安く・速く・正確」。
const MODEL_EXTRACT = "gpt-4o";  // 記録面(用紙)の読み取り
const MODEL_LABEL   = "gpt-4o";  // 材料シールの読み取り
// ▲▲ モデル設定ここまで ▲▲

const EXTRACT_CHUNK  = 8;   // 1回の呼び出しで聞く項目数。多すぎると○判定が雑になるので小さめ

// ▼▼ 【重要】OpenAIのTPM(1分あたりトークン数)上限に合わせた設定 ▼▼
//   gpt-4o は Tier 1 だと 30,000 TPM しかない。
//   1症例の読み取りで使う量の目安(TSARSA・44項目):
//       EXTRACT_PASSES=1 かつ 全面を送らない … 約 22,000  → 30,000枠に収まる
//       EXTRACT_PASSES=2 かつ 全面も送る     … 約 50,000  → 枠を超えて429になる
//   累計 $50 以上の支払いで Tier 2 になると 450,000 TPM まで上がるので、
//   その場合は EXTRACT_PASSES=2 / SEND_FULL_PAGE=true に戻して精度重視にできる。
//   現在のティアは platform.openai.com の Settings → Limits で確認できる。
const EXTRACT_PASSES = 1;   // 同じ項目を何回読ませて突き合わせるか(2にすると読み取りのブレを検出できるが倍のトークンを使う)
const SEND_FULL_PAGE = false; // 記録面で「全面」も送るか(帯だけで全体を覆えているのでfalseで足りる)
const EXTRACT_CONCURRENCY = 2;  // AI呼び出しの同時実行数
// ▲▲ ここまで ▲▲

const MAX_RETRY      = 6;   // 429/5xx のリトライ回数(TPMの枠が空くのを待てるよう多め)
async function loadMaster(env, id) {
  const clean = sanitizeId(id || "");
  if (!clean) return null;
  const raw = await env.FORM_KV.get(KV_PREFIX + clean);
  if (!raw) return null;
  try {
    const m = JSON.parse(raw);
    if (!m.items) m.items = [];
    return m;
  } catch (e) {
    return null;
  }
}

// ---------- 用紙OCR抽出 ----------
async function apiExtract(env, body) {
  if (!env.OPENAI_API_KEY) return jsonError("OPENAI_API_KEY が設定されていません", 500);

  const masterId = sanitizeId((body && body.masterId) || "");
  const pages = Array.isArray(body && body.pages) ? body.pages : [];
  if (!masterId) return jsonError("masterIdが不正です", 400);
  if (!pages.length) return jsonError("記録面の画像がありません", 400);

  const master = await loadMaster(env, masterId);
  if (!master) return jsonError("マスタが見つかりません: " + masterId, 404);

  const results = {};
  const disagreeOut = {};
  const snapOut = {};                       // 氏名を補正した記録
  const doctors = await getDoctors(env);
  const doctorFields = [];                  // 医師マスタを使う項目名
  for (const it of master.items) {
    if (it.suggest === "doctor") doctorFields.push(it.label);
  }

  // 固定値はOCR不要 — サーバー側でそのまま埋める
  for (const it of master.items) {
    if (it.type === "fixed") results[String(it.no)] = it.value || "";
  }

  // 千葉大セクションのうち、JOANR項目と中身が同じものはAIに聞かず後で写す
  //   (同じ用紙を2回読んで値が食い違う事故を防ぎ、そのぶん費用も減らす)
  const copyPairs = [];          // { toNo, fromNo }
  const copySkip = new Set();    // AIに投げない項目のno
  {
    const srcByLabel = new Map();
    for (const it of master.items) {
      if (isChibaSection(it.section)) continue;      // 写し元はJOANR側から探す
      const lb = String(it.label || "").trim();
      if (lb && !srcByLabel.has(lb)) srcByLabel.set(lb, it);
    }
    for (const it of master.items) {
      if (!isChibaSection(it.section)) continue;
      if (it.type !== "ocr" && it.type !== "choice") continue;
      const lb = String(it.label || "").trim();
      const src = srcByLabel.get(lb) || srcByLabel.get("患者" + lb);
      if (!src) continue;
      copyPairs.push({ toNo: String(it.no), fromNo: String(src.no) });
      copySkip.add(String(it.no));
    }
  }

  // OCR対象(ocr / choice)だけをAIに投げる
  const targets = master.items.filter(
    (it) => (it.type === "ocr" || it.type === "choice") && !copySkip.has(String(it.no))
  );

  // 記録面を {num, image} に正規化(文字列だけの旧形式も受ける)
  const pageList = [];
  for (const p of pages) {
    if (typeof p === "string" && p.indexOf("data:image/") === 0) pageList.push({ num: 0, image: p });
    else if (p && typeof p.image === "string" && p.image.indexOf("data:image/") === 0) {
      pageList.push({ num: Number(p.num) || 0, image: p.image });
    }
  }
  if (!pageList.length) return jsonError("画像データが不正です", 400);

  let usage = null;
  if (targets.length) {
    // ルール文中の「1P目」「2P目」でページを絞る → 送る画像が減り、AIの探索範囲も狭まる
    const groups = new Map();
    for (const it of targets) {
      const h = pageHintOf(it);
      if (!groups.has(h)) groups.set(h, []);
      groups.get(h).push(it);
    }

    const got = {};
    const disagree = {};

    // 一度に多くを聞くと精度が落ちるので小分けにする
    const chunkDefs = [];
    for (const [hint, list] of groups) {
      const imgs = pickImages(pageList, hint);
      for (let i = 0; i < list.length; i += EXTRACT_CHUNK) {
        chunkDefs.push({ chunk: list.slice(i, i + EXTRACT_CHUNK), imgs: imgs });
      }
    }

    // チャンク × パス を並行実行する(直列だと待ち時間が積み上がるため)
    const jobs = [];
    for (let ci = 0; ci < chunkDefs.length; ci++) {
      for (let pass = 0; pass < EXTRACT_PASSES; pass++) {
        jobs.push({ ci: ci, run: (function (d) {
          return function () { return extractChunk(env, d.chunk, d.imgs, doctors); };
        })(chunkDefs[ci]) });
      }
    }
    const done = await runPool(jobs.map(function (j) { return j.run; }), EXTRACT_CONCURRENCY);

    const byChunk = [];
    for (let k = 0; k < jobs.length; k++) {
      const ci = jobs[k].ci;
      if (!byChunk[ci]) byChunk[ci] = [];
      const part = done[k] || {};
      byChunk[ci].push(part.results || {});
      if (part.usage) {
        if (!usage) usage = { prompt_tokens: 0, completion_tokens: 0, total_tokens: 0 };
        usage.prompt_tokens += part.usage.prompt_tokens || 0;
        usage.completion_tokens += part.usage.completion_tokens || 0;
        usage.total_tokens += part.usage.total_tokens || 0;
      }
    }

    // 同じ問いの複数回答を突き合わせる。幻覚は毎回違う値になるので炙り出せる
    for (let ci = 0; ci < chunkDefs.length; ci++) {
      const passes = byChunk[ci] || [];
      for (const it of chunkDefs[ci].chunk) {
        const key = String(it.no);
        const vals = [];
        for (const r of passes) vals.push(String(r[key] == null ? "" : r[key]).trim());
        got[key] = voteStr(vals);
        let allSame = true;
        for (const v of vals) if (v !== vals[0]) allSame = false;
        if (!allSame) disagree[key] = vals;
      }
    }

    for (const it of targets) {
      const key = String(it.no);
      let v = got[key];
      if (v == null) v = "";
      v = String(v).trim();
      if (it.choices && it.choices.length && v) {
        let ok = false;
        for (const c of it.choices) { if (String(c).trim() === v) { ok = true; break; } }
        if (!ok) v = "";
      }
      // 医師マスタがある項目は、最も近い氏名へ寄せる(室置→玉置 のような1文字誤読の吸収)
      if (it.suggest === "doctor" && v && doctors.length) {
        const sn = snapNames(v, doctors);
        if (sn.fixes.length) snapOut[key] = sn.fixes;
        v = sn.value;
      }
      results[key] = v;
      if (disagree[key]) disagreeOut[key] = disagree[key];
    }
  }

  // JOANR項目から千葉大項目へ写す(AIに聞かずに同じ値をそのまま使う)
  for (const pair of copyPairs) {
    const v = results[pair.fromNo];
    if (v == null || v === "") continue;
    results[pair.toNo] = v;
  }

  return jsonOk({
    results: results, master: master, usage: usage,
    disagree: disagreeOut, snapped: snapOut,
    doctorInfo: { count: doctors.length, fields: doctorFields },
  });
}

// 複数回の読み取り結果から最頻値を採る(同数なら空でない最初の値)
function voteStr(vals) {
  const counts = {};
  let best = "", bestN = 0;
  for (const v of vals) {
    if (!v) continue;
    counts[v] = (counts[v] || 0) + 1;
    if (counts[v] > bestN) { best = v; bestN = counts[v]; }
  }
  return best;
}

// 1チャンク分をAIに投げる
async function extractChunk(env, chunk, imgs, doctors) {
  const spec = chunk.map((it) => {
    const o = { no: it.no, 項目名: it.label };
    if (it.keyword) o.用紙上の目印 = it.keyword;
    if (it.rule) o.抽出ルール = it.rule;
    if (it.choices && it.choices.length) o.選択肢 = it.choices;
    // 医師マスタを持つ項目には候補氏名を渡す(表記の手がかりになる)
    if (it.suggest === "doctor" && doctors && doctors.length) {
      o.補足 = "この項目は院内の医師名簿から選ぶ。用紙の字と一字一句同じでなくてよいので、字形が最も近い医師を名簿から選ぶこと。該当が全く無ければ空の配列を返す。";
    }
    return o;
  });

  // 画像を先、指示を後 — オペパシャと同じ並び
  const content = [];
  for (const p of imgs) content.push({ type: "image_url", image_url: { url: p, detail: "high" } });
  content.push({ type: "text", text: EXTRACT_USER_HEAD + JSON.stringify(spec, null, 1) });

  // strict schema: 聞いた項目を必ず全部、文字列で返させる(欠落・余計なキーを封じる)
  const props = {};
  const required = [];
  for (const it of chunk) {
    const k = "n" + it.no;
    // 医師マスタを持つ項目は enum にする = リストに無い氏名は構造的に返せない
    if (it.suggest === "doctor" && doctors && doctors.length) {
      props[k] = {
        type: "array",
        description: (it.label + " / 用紙の字に最も近い医師を候補から選ぶ。該当が無ければ空の配列。").slice(0, 300),
        items: { type: "string", enum: doctors },
      };
    } else {
      let desc = it.label;
      if (it.choices && it.choices.length) desc += " / 次のいずれか1つ、または空文字: " + it.choices.join(" , ");
      props[k] = { type: "string", description: desc.slice(0, 300) };
    }
    required.push(k);
  }
  const schema = {
    name: "extract_result",
    strict: true,
    schema: { type: "object", additionalProperties: false, properties: props, required: required },
  };

  const out = await callOpenAI(
    env, MODEL_EXTRACT,
    [
      { role: "system", content: EXTRACT_SYSTEM },
      { role: "user", content: content },
    ],
    2000, schema
  );

  const results = {};
  const raw = out.json || {};
  for (const it of chunk) {
    const v = raw["n" + it.no];
    if (Array.isArray(v)) results[String(it.no)] = v.join("、");     // 医師は配列で返る
    else results[String(it.no)] = (v == null) ? "" : String(v);
  }
  return { results: results, usage: out.usage || null };
}

// ルール/目印に書かれたページ指定を拾う(0 = 指定なし)
function pageHintOf(it) {
  const s = String(it.rule || "") + " " + String(it.keyword || "");
  if (s.indexOf("1P") >= 0 || s.indexOf("1ページ") >= 0) return 1;
  if (s.indexOf("2P") >= 0 || s.indexOf("2ページ") >= 0) return 2;
  if (s.indexOf("3P") >= 0 || s.indexOf("3ページ") >= 0) return 3;
  return 0;
}

function pickImages(pageList, hint) {
  if (hint > 0) {
    const hit = [];
    for (const p of pageList) if (p.num === hint) hit.push(p.image);
    if (hit.length) return hit;
  }
  const all = [];
  for (const p of pageList) all.push(p.image);
  return all;
}

// ---------- 材料シール読取 ----------
async function apiLabel(env, body) {
  if (!env.OPENAI_API_KEY) return jsonError("OPENAI_API_KEY が設定されていません", 500);

  const image = (body && body.image) || "";
  if (typeof image !== "string" || image.indexOf("data:image/") !== 0) {
    return jsonError("画像データが不正です", 400);
  }

  const out = await callOpenAI(
    env,
    MODEL_LABEL,
    [
      { role: "system", content: LABEL_SYSTEM },
      {
        role: "user",
        content: [
          { type: "image_url", image_url: { url: image, detail: "high" } },
          { type: "text", text: "この画像からすべての材料ラベル情報を抽出してください。" },
        ],
      },
    ],
    4000, LABEL_SCHEMA
  );

  const rawItems = (out.json && out.json.items) || [];
  const items = [];
  for (const r of rawItems) {
    if (!r) continue;
    const title = String(r.title || "").trim();
    if (!title) continue;
    let lot = String(r.lot || "").trim();
    let exp0 = String(r.exp || "").trim();
    // このメーカーのラベルは SN のみで LOT が無いものが多く、期限をLOT欄に入れる誤りが多発する
    if (looksLikeDate(lot)) { if (!exp0) exp0 = lot; lot = ""; }
    const gtinDigits = onlyDigits(r.gtin || "");
    const gtinValid = gtinLenOk(gtinDigits) && gtinCheckOk(gtinDigits);
    const gtin = gtinValid ? gtinDigits : "";               // 検証を通らない値は採用しない
    const gtinRaw = (!gtinValid && gtinDigits) ? gtinDigits : "";
    const gtinNg = !!gtinRaw;
    const exp = exp0;
    items.push({
      title: title,
      gtin: gtin,
      gtinRaw: gtinRaw,         // 検証を通らなかった生の読み取り値
      gtinNg: gtinNg,           // ⚠️要確認フラグ(チェックデジット不一致)
      expNg: isPastDate(exp),   // ⚠️要確認フラグ(期限が過去=年の誤読の可能性)
      ref: String(r.ref || "").trim(),
      lot: lot,
      sn: String(r.sn || "").trim(),
      maker: String(r.maker || "").trim(),
      exp: exp,
    });
  }

  return jsonOk({ items: items, usage: out.usage || null });
}

// ---------- OpenAI呼び出し ----------
function sleep(ms) {
  return new Promise(function (r) { setTimeout(r, ms); });
}

// 同時実行数を制限しながら並行に走らせる(順番は保持)
async function runPool(tasks, limit) {
  const out = new Array(tasks.length);
  let next = 0;
  const n = Math.min(Math.max(1, limit), tasks.length);
  const workers = [];
  for (let w = 0; w < n; w++) {
    workers.push((async function () {
      while (true) {
        const my = next++;
        if (my >= tasks.length) break;
        out[my] = await tasks[my]();
      }
    })());
  }
  await Promise.all(workers);
  return out;
}

// レスポンスから「どれだけ待てばよいか」を割り出す
function retryWaitMs(res, text, attempt) {
  const raMs = res.headers.get("retry-after-ms");
  if (raMs) {
    const n = Number(raMs);
    if (!isNaN(n) && n > 0) return Math.min(n + 250, 65000);
  }
  const ra = res.headers.get("retry-after");
  if (ra) {
    const n = Number(ra);
    if (!isNaN(n) && n > 0) return Math.min(n * 1000 + 250, 65000);
  }
  // 本文の "Please try again in 387ms" / "in 1.5s" を拾う
  const m = /try again in ([0-9.]+)\s*(ms|s)\b/i.exec(String(text || ""));
  if (m) {
    const v = parseFloat(m[1]);
    if (!isNaN(v)) {
      const ms = (m[2].toLowerCase() === "ms") ? v : v * 1000;
      return Math.min(ms + 800, 65000);
    }
  }
  return Math.min(1500 * Math.pow(2, attempt) + Math.floor(Math.random() * 500), 65000);
}

async function callOpenAI(env, model, messages, maxTokens, schema) {
  let lastMsg = "";
  let res = null;

  for (let attempt = 0; attempt <= MAX_RETRY; attempt++) {
    res = await fetch("https://api.openai.com/v1/chat/completions", {
      method: "POST",
      headers: {
        "content-type": "application/json",
        authorization: "Bearer " + env.OPENAI_API_KEY,
      },
      body: JSON.stringify({
        model: model,
        messages: messages,
        max_completion_tokens: maxTokens || 2000,
        temperature: 0,
        response_format: schema
          ? { type: "json_schema", json_schema: schema }
          : { type: "json_object" },
      }),
    });
    if (res.ok) break;

    const t = await res.text();
    lastMsg = "OpenAIエラー(" + res.status + "): " + t.slice(0, 300);
    // 429(レート制限)と5xx(一時障害)だけ待って再試行
    if (res.status === 429 || res.status >= 500) {
      if (attempt === MAX_RETRY) {
        if (res.status === 429 && t.indexOf("tokens per min") >= 0) {
          throw new Error(
            "OpenAIの1分あたりトークン上限(TPM)に達しました。1症例で使う量が上限を超えています。" +
            "コード冒頭の EXTRACT_PASSES を 1 に、SEND_FULL_PAGE を false にすると使用量が半分以下になります。" +
            "根本的には OpenAI の利用ティアを上げると上限が大きく上がります（Settings → Limits で確認できます）。"
          );
        }
        throw new Error(lastMsg + " ／ 再試行しても解消しませんでした");
      }
      await sleep(retryWaitMs(res, t, attempt));
      continue;
    }
    throw new Error(lastMsg);
  }
  if (!res || !res.ok) throw new Error(lastMsg || "OpenAI呼び出しに失敗しました");

  const data = await res.json();
  const text = (data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content) || "";
  let json = null;
  try {
    json = JSON.parse(text);
  } catch (e) {
    throw new Error("AIの応答がJSONとして読めませんでした");
  }
  return { json: json, usage: data.usage || null };
}

// ---------- YYYY-MM-DD 形式かどうか ----------
function looksLikeDate(s) {
  const t = String(s || "").trim();
  if (t.length !== 10) return false;
  if (t.charAt(4) !== "-" || t.charAt(7) !== "-") return false;
  for (let i = 0; i < 10; i++) {
    if (i === 4 || i === 7) continue;
    const c = t.charAt(i);
    if (c < "0" || c > "9") return false;
  }
  return true;
}

// ---------- 期限の妥当性(過去日付は年の誤読を疑う) ----------
function isPastDate(s) {
  const t = String(s || "").trim();
  if (t.length < 7) return false;
  const d = Date.parse(t);
  if (isNaN(d)) return false;
  return d < Date.now();
}

// ---------- GTINチェックデジット(モジュロ10) ----------
function onlyDigits(s) {
  const str = String(s || "");
  let out = "";
  for (let i = 0; i < str.length; i++) {
    const c = str.charAt(i);
    if (c >= "0" && c <= "9") out += c;
  }
  return out;
}

function gtinLenOk(g) {
  return g.length === 8 || g.length === 12 || g.length === 13 || g.length === 14;
}

// モジュロ10。チェックデジットから数えて奇数位置を3倍(桁数可変)
function gtinCheckOk(gtin) {
  if (!gtinLenOk(gtin)) return false;
  const n = gtin.length;
  let sum = 0;
  for (let i = 0; i < n - 1; i++) {
    const d = gtin.charCodeAt(i) - 48;
    sum += ((n - 1 - i) % 2 === 1) ? d * 3 : d;
  }
  const cd = (10 - (sum % 10)) % 10;
  return cd === (gtin.charCodeAt(n - 1) - 48);
}


