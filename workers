// 千葉大の項目を持つ用紙のIDを集める
//   KVからマスタ本体を読んで、セクション名に「千葉大」が入る項目があるかで判定する
async function chibaMasterIds(env) {
  const ids = [];
  if (!env || !env.FORM_KV) return ids;
  try {
    const res = await env.FORM_KV.list({ prefix: KV_PREFIX });
    for (const k of res.keys) {
      const id = k.name.slice(KV_PREFIX.length);
      let obj = null;
      try {
        const raw = await env.FORM_KV.get(k.name, { cacheTtl: 300 });
        if (!raw) continue;
        obj = JSON.parse(raw);
      } catch (e) { continue; }
      const items = (obj && obj.items) || [];
      for (const it of items) {
        if (isChibaSection(it.section)) { ids.push(id); break; }
      }
    }
  } catch (e) {}
  return ids;
}

// payloadから千葉大セクションの項目だけ取り出す
function pickChibaFields(payload) {
  let p = {};
  try { p = JSON.parse(payload || "{}"); } catch (e) { return []; }
  const out = [];
  for (const f of (p.fields || [])) {
    if (!isChibaSection(f.section)) continue;
    out.push({ no: f.no, label: f.label, value: f.value == null ? "" : String(f.value) });
  }
  return out;
}

async function listChibaWork(env, params) {
  if (!env.opecopy_db) return jsonError("D1バインディング opecopy_db が設定されていません", 500);
  const p = params || new URLSearchParams();
  const done = (p.get("done") || "") === "1";
  const ids = await chibaMasterIds(env);
  if (!ids.length) return jsonOk({ records: [], count: 0, note: "千葉大用の項目を持つ用紙がありません" });

  const holes = ids.map(() => "?").join(",");
  const where = ["deleted_at IS NULL", "master_id IN (" + holes + ")"];
  const args = ids.slice();
  where.push(done ? "chiba_at IS NOT NULL" : "chiba_at IS NULL");
  const from = (p.get("from") || "").trim();
  const to = (p.get("to") || "").trim();
  if (from) { where.push("surgery_date >= ?"); args.push(from); }
  if (to) { where.push("surgery_date <= ?"); args.push(to); }
  let limit = parseInt(p.get("limit") || "50", 10);
  if (!(limit > 0) || limit > 200) limit = 50;

  const sql =
    "SELECT id, patient_no, surgery_date, master_name, updated_by, updated_at, chiba_at, payload " +
    "FROM records WHERE " + where.join(" AND ") +
    " ORDER BY surgery_date ASC, id ASC LIMIT ?";
  const rs = await env.opecopy_db.prepare(sql).bind(...args, limit).all();

  // payloadは重いので、千葉大の項目だけに絞って返す
  const records = [];
  for (const r of (rs && rs.results) || []) {
    records.push({
      id: r.id, patient_no: r.patient_no, surgery_date: r.surgery_date,
      master_name: r.master_name, updated_by: r.updated_by, updated_at: r.updated_at,
      chiba_at: r.chiba_at, fields: pickChibaFields(r.payload),
    });
  }
  return jsonOk({ records: records, count: records.length, done: done });
}

async function markChibaDone(env, body) {
  if (!env.opecopy_db) return jsonError("D1バインディング opecopy_db が設定されていません", 500);
  const b = body || {};
  const id = Number(b.id || 0);
  if (!id) return jsonError("idが不正です", 400);
  const val = b.done === false ? null : new Date().toISOString();
  await env.opecopy_db.prepare(
    "UPDATE records SET chiba_at=? WHERE id=? AND deleted_at IS NULL"
  ).bind(val, id).run();
  return jsonOk({ id: id, done: !!val });
}

