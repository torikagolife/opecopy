<script>
// ============================================================
// 状態
// ============================================================
var cur = null;          // 編集中マスタ {id,name,items:[]}
var curIsNew = false;    // 新規作成中か
var dragFrom = -1;       // ドラッグ元index

var TYPES = [
  ["ocr",     "\uD83D\uDD0D OCR読取"],
  ["choice",  "☑️ 選択肢"],
  ["fixed",   "\uD83D\uDCCC 固定値"],
  ["sticker", "\uD83C\uDFF7️ 材料シール"],
  ["confirm", "❓ 要確認"],
  ["unset",   "⬜ 未設定"]
];

// ============================================================
// 共通ユーティリティ
// ============================================================
function $(id){ return document.getElementById(id); }

function esc(s){
  return String(s == null ? "" : s)
    .replace(/&/g,"&amp;").replace(/</g,"&lt;")
    .replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}

function splitList(s){
  if (Object.prototype.toString.call(s) === "[object Array]") {
    var r = [];
    for (var k=0;k<s.length;k++){ var v=String(s[k]==null?"":s[k]).trim(); if(v) r.push(v); }
    return r;
  }
  var t = String(s == null ? "" : s);
  t = t.split("、").join(",");
  t = t.split("，").join(",");
  t = t.split(String.fromCharCode(10)).join(",");
  var a = t.split(",");
  var out = [];
  for (var i=0;i<a.length;i++){ var x = a[i].trim(); if(x) out.push(x); }
  return out;
}

function sanitizeId(s){
  var lower = String(s||"").trim().toLowerCase();
  var out = "";
  for (var i=0;i<lower.length;i++){
    var c = lower.charAt(i);
    var isNum = (c >= "0" && c <= "9");
    var isAl  = (c >= "a" && c <= "z");
    if (isNum || isAl || c === "-" || c === "_") out += c;
  }
  return out.slice(0,60);
}

// 先頭と末尾の区切り文字を落とす
function trimSep(s){
  var a = 0, b = s.length;
  while (a < b && (s.charAt(a) === "-" || s.charAt(a) === "_")) a++;
  while (b > a && (s.charAt(b-1) === "-" || s.charAt(b-1) === "_")) b--;
  return s.slice(a, b);
}

// 名前から決まる短いハッシュ(FNV-1a)。同じ名前なら必ず同じ値になる
function hashId(name){
  var h = 2166136261;
  for (var i=0;i<name.length;i++){
    h = h ^ name.charCodeAt(i);
    h = (h + ((h<<1)+(h<<4)+(h<<7)+(h<<8)+(h<<24))) >>> 0;   // h * 16777619
  }
  return h.toString(36);
}

// シート名からIDを作る
//   日本語だけの名前は半角英数字が残らないため、名前から決まるハッシュを使う。
//   (以前は現在時刻を使っていたので、取り込み直すたびに別マスタが増えていた)
//   また "下肢_半月板" のように区切り文字しか残らない名前が
//   すべて同じIDになって互いを上書きしていたのも、ここで防いでいる。
// ▼▼ IDを読みやすくするための言い換え表 ▼▼
//   ここに無い言葉は名前から決まるハッシュになる。増やしたければ足すだけ。
var ID_WORDS = [
  ["下肢", "kashi"], ["上肢", "joshi"], ["脊椎", "sekitsui"], ["一般", "ippan"],
  ["半月板", "hangetsuban"], ["直視下", "chokushika"], ["鏡視下", "kyoshika"],
  ["足関節", "ashi"], ["膝関節", "hiza"], ["肩関節", "kata"], ["肘関節", "hiji"],
  ["股関節", "kokansetsu"], ["人工関節", "jinko"], ["靭帯", "jintai"],
  ["骨折", "kossetsu"], ["手", "te"], ["片", ""]
];
// ▲▲ ここまで ▲▲

function romanize(name){
  var t = String(name || "");
  for (var i=0;i<ID_WORDS.length;i++){
    t = t.split(ID_WORDS[i][0]).join("_" + ID_WORDS[i][1] + "_");
  }
  return t;
}

function autoId(name){
  // 日本語が混じっている名前は、まず言い換え表を通す
  //   （"下肢_ACL_PCL" が "acl_pcl" になって他の下肢シートと系統が揃わないのを防ぐ）
  var r = trimSep(sanitizeId(romanize(name)));
  while (r.indexOf("__") >= 0) r = r.split("__").join("_");
  if (r.length >= 2) return r;
  var core = trimSep(sanitizeId(name));
  if (core.length >= 2) return core;
  return "m" + hashId(String(name || ""));
}

// 使用済みIDと重ならないようにする
function uniqueId(id, used){
  var base = sanitizeId(id) || "m";
  var out = base, n = 2;
  while (used[out]){ out = (base + "-" + n).slice(0, 60); n++; }
  used[out] = 1;
  return out;
}

function toast(msg){
  var t = $("toast");
  t.textContent = msg;
  t.classList.add("show");
  setTimeout(function(){ t.classList.remove("show"); }, 2200);
}

function fmtDate(iso){
  if (!iso) return "-";
  try {
    var d = new Date(iso);
    return d.toLocaleString("ja-JP", { year:"numeric", month:"2-digit", day:"2-digit", hour:"2-digit", minute:"2-digit" });
  } catch(e){ return "-"; }
}

async function api(path, opt){
  opt = opt || {};
  var h = {};
  if (opt.headers){ for (var k in opt.headers) h[k] = opt.headers[k]; }
  var t = getToken();
  if (t) h["x-ope-auth"] = t;
  var st = getSessTok();
  if (st) h["x-ope-sess"] = st;      // Cookieが送れない環境の保険
  opt.headers = h;
  var res = await fetch(path, opt);
  if (res.status === 401){ clearToken(); showLogin(); throw new Error("認証が必要です"); }
  var data = await res.json();
  if (!data.ok) throw new Error(data.error || "APIエラー");
  return data;
}

