// ============================================================
// オペコピ (opecopy) — 対象用紙マスタ管理
//   https://opecopy.toriweb.workers.dev/
//
// [画面]
//   GET  /            … オペコピ本体(記録PDF→JOANR入力補助)
//   GET  /admin       … 対象用紙マスタ管理画面
//
// [API]
//   GET  /api/masters        … マスタ一覧
//   GET  /api/master?id=xxx  … マスタ1件取得
//   POST /api/master         … マスタ保存(新規/上書き)
//   POST /api/master/delete  … マスタ削除
//   POST /api/extract        … 記録面画像 + マスタ → 各項目の値をJSON抽出
//   POST /api/label          … シール面画像 → 材料ラベル情報を抽出
//   POST /api/kcode          … 術式名 → 登録術式(Kコード)の候補5件
//   GET  /api/authinfo       … パスワード保護が有効かどうか(認証不要)
//   POST /api/login          … パスワード照合 → トークン発行(認証不要)
//
// [必要な設定]
//   KVバインディング: FORM_KV (変数名もFORM_KVにすること)
//   Secret: OPENAI_API_KEY
//   Secret: PW_OPE … 閲覧パスワード。未設定なら認証なしで動く
//
// [マスタJSONの形]
//   {
//     id: "tsarsa",
//     name: "TSARSA（人工肩関節/リバース）",
//     updatedAt: "2026-07-28T12:00:00.000Z",
//     items: [
//       { no:1, section:"基本項目", label:"入院手術／外来手術", type:"fixed",  value:"入院手術" },
//       { no:2, section:"基本項目", label:"主たる術式　術式",   type:"ocr",    keyword:"施行術式", rule:"右側" },
//       { no:3, section:"手術概要", label:"手術側",             type:"choice", choices:["左","右"], keyword:"施行術式", rule:"左右ピックアップ" },
//       { no:4, section:"材料系",   label:"セメント",           type:"sticker", matKeywords:["セメント","CEMENT","Palacos"] },
//       { no:5, section:"",         label:"技師数",             type:"confirm" },
//       { no:6, section:"",         label:"手術日",             type:"unset" }
//     ]
//   }
//
//   type一覧:
//     ocr     … 用紙をOCRして読む (keyword=用紙上のラベル / rule=抽出ルール)
//     choice  … 選択肢から選ぶ  (choices=候補 / keyword / rule)
//     fixed   … 固定値 (value)  ※OCR不要
//     sticker … 材料シールから取得 (matKeywords=その材料を特定するキーワード群)
//     confirm … 人が確認して入力
//     unset   … 未マッピング
//
//   ※旧Excelの「読取りフォーカス」列(D列)は廃止。取込時に読み飛ばす。
// ============================================================

const KV_PREFIX = "master:";
const DOCTORS_KEY = "staff:doctors";
const USERS_KEY = "auth:users";   // BASIC認証の利用者名簿(KV)
const KCODE_KEY = "kcode:list";   // 術式マスタ(Kコード)。KVが空ならコード内の初期値を使う
const MAILTPL_KEY = "mail:templates";   // 管理者用の定型文(3件)
const CHIBA_KEYS = {                    // 千葉大フォーム用の選択肢リスト
  byomei: "chiba:byomei",
  jutsushiki: "chiba:jutsushiki",
};
const SESS_COOKIE = "ope_sess";         // ログインセッションのCookie名
const ADMIN_COOKIE = "ope_admin";       // 管理画面(PW_OPE)を通った証のCookie名
const ADMIN_HOURS = 12;                 // 管理画面セッションの有効時間
const SESS_DAYS = 7;                    // セッションの有効日数
const REPORT_KEEP_DAYS = 30;            // 利用者からの報告を保持する日数

// ▼▼ 認証を外したいAPIがあればここに書く ▼▼
//   既定は空 = すべてのAPIがパスワード保護される。
//   例) ["/api/masters"] にすると、対象用紙の一覧だけログイン前でも取得できる。
const AUTH_FREE_PATHS = [];

// ▼▼ QR認証の設定 ▼▼
//   PC画面にランダムなQRを表示 → スマホでURLを開くだけで認証完了。
//   スマホには何も保存しない（個人スマホでも使えるように、登録もPIN入力も無し）。
//
//   【QRの中身】
//     画面に出す6桁の数字は「PCとスマホで同じ番号か目視で確かめる」ためのもの。
//     QRのURLに入る実際の鍵は、別に発行する長いランダム文字列。
//     6桁だけを鍵にすると総当たりで当てられてしまうため、この2階建てにしている。
const QR_ENABLED        = false; // BASIC認証に一本化したため無効（コードは残置）
const QR_TTL_SEC        = 180;   // QRの有効期限(秒)。切れたら再表示ボタンで発行し直す
const QR_SESSION_HOURS  = 12;    // 認証後、PCが読み取りを行える時間
const QR_SLOT_SEC       = 5;     // 何秒ごとに別のキーを見に行くか（KVのキャッシュ対策）
const QR_SLOT_COUNT     = 12;    // スマホが先に書いておくスロット数（5秒×12＝60秒ぶん）
// 患者画像を外部AIに送る操作だけQRを必須にする。管理画面の作業は妨げない。
const QR_PROTECTED_PATHS = ["/api/extract", "/api/label", "/api/kcode"];
// ▲▲ ここまで ▲▲
// ▲▲ ここまで ▲▲

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const path = url.pathname;
    const method = request.method;

    let authUser = "";
    try {
      // ---------- 外周ゲート ----------
      // ① 許可IP以外は入口で遮断（ログイン画面すら見せない）
      if (!ipAllowed(request, env)) {
        // 詳細は出さない(許可条件を推測させないため)
        return new Response("接続が許可されていません", {
          status: 403,
          headers: { "content-type": "text/plain; charset=utf-8" },
        });
      }
      // ② ログイン確認。Cookie か Authorizationヘッダ(BASIC)で照合する
      //    ログイン処理そのものは通さないと入口が塞がるので先に通す
      const isLoginPath = (path === "/login" || path === "/api/session" || path === "/api/logout");
      const gate = isLoginPath ? { ok: true, user: "" } : await basicGate(request, env);
      if (!gate.ok) {
        // 画面はログインフォームを出す(サイドバーではBASICのダイアログが出せないため)
        if (method === "GET" && !path.startsWith("/api/")) {
          return new Response(LOGIN_HTML, {
            status: 200,
            headers: { "content-type": "text/html; charset=utf-8" },
          });
        }
        return jsonError("ログインが必要です", 401);
      }
      authUser = gate.user;

      // ---------- ログイン関連 ----------
      if (method === "GET" && path === "/login") {
        return new Response(LOGIN_HTML, { status: 200, headers: { "content-type": "text/html; charset=utf-8" } });
      }
      if (method === "POST" && path === "/api/session") {
        return await apiSessionLogin(env, await request.json());
      }
      if (method === "POST" && path === "/api/logout") {
        return apiLogout();
      }
      if (method === "GET" && path === "/api/whoami") {
        return jsonOk({ user: authUser });
      }

      // ---------- 画面 ----------
      if (method === "GET" && (path === "/" || path === "")) {
        return new Response(applyHelpLink(FRONT_HTML, envStr(env, "HELP_USERS")), {
          headers: { "content-type": "text/html; charset=utf-8" },
        });
      }
      if (method === "GET" && (path === "/admin" || path === "/admin/")) {
        // PW_OPEが設定されているならCookieを確認し、無ければログイン画面を返す
        if (authRequired(env) && !(await readAdminCookie(request, env))) {
          return new Response(ADMIN_LOGIN_HTML, {
            status: 200,
            headers: { "content-type": "text/html; charset=utf-8" },
          });
        }
        return new Response(applyHelpLink(ADMIN_HTML, envStr(env, "HELP_ADMIN")), {
          headers: { "content-type": "text/html; charset=utf-8" },
        });
      }

      // ---------- 認証 ----------
      // 画面(HTML)は誰でも取得できるが、中身のAPIは保護する
      if (method === "GET" && path === "/api/authinfo") {
        return jsonOk({ required: authRequired(env) });
      }
      if (method === "POST" && path === "/api/login") {
        return await apiLogin(env, await request.json());
      }
      if (method === "GET" && path === "/api/qrinfo") {
        return jsonOk({ required: qrRequired(env), ttl: QR_TTL_SEC });
      }
      // スマホ側の画面と承認APIは、PCのパスワードを持たないため認証を通さない
      if (method === "GET" && (path === "/pair" || path === "/pair/")) {
        return new Response(PAIR_HTML, { headers: { "content-type": "text/html; charset=utf-8" } });
      }
      if (method === "POST" && path === "/api/qr/approve") {
        return await apiQrApprove(env, await request.json());
      }
      // 外周はBASICが守るので、PW_OPEは管理系APIだけに効かせる
      if (isAdminApi(method, path) && !(await checkAuth(request, env))) {
        return jsonError("認証が必要です", 401);
      }
      // 患者画像を外部AIに送る操作は、スマホ承認済みであることを追加で確認する
      if (QR_ENABLED && QR_PROTECTED_PATHS.indexOf(path) >= 0 && !(await checkQrSession(request, env))) {
        return jsonError("スマホでのQR認証が必要です。画面を再読み込みして認証し直してください。", 401);
      }
      if (method === "POST" && path === "/api/qr/new") {
        return await apiQrNew(env);
      }
      if (method === "GET" && path === "/api/qr/status") {
        return await apiQrStatus(env, url.searchParams.get("t"));
      }
      if (method === "GET" && path === "/api/qr/check") {
        return await apiQrCheck(request, env);
      }

      // ---------- API ----------
      if (!env.FORM_KV) {
        if (path.startsWith("/api/")) {
          return jsonError("KVバインディング FORM_KV が設定されていません", 500);
        }
      }

      if (method === "GET" && path === "/api/masters") {
        return await listMasters(env);
      }
      if (method === "GET" && path === "/api/master") {
        return await getMaster(env, url.searchParams.get("id"));
      }
      if (method === "POST" && path === "/api/master") {
        return await saveMaster(env, await request.json());
      }
      if (method === "POST" && path === "/api/master/delete") {
        return await deleteMaster(env, await request.json());
      }
      if (method === "POST" && path === "/api/extract") {
        return await apiExtract(env, await request.json());
      }
      if (method === "POST" && path === "/api/label") {
        return await apiLabel(env, await request.json());
      }
      if (method === "POST" && path === "/api/kcode") {
        return await apiKcode(env, await request.json());
      }
      if (method === "GET" && path === "/api/doctors") {
        return await apiGetDoctors(env);
      }
      if (method === "POST" && path === "/api/doctors") {
        return await apiSaveDoctors(env, await request.json());
      }
      if (method === "POST" && path === "/api/record") {
        return await saveRecord(env, await request.json(), authUser);
      }
      if (method === "GET" && path === "/api/record") {
        return await getRecord(env, url.searchParams.get("id"));
      }
      if (method === "GET" && path === "/api/record/find") {
        return await findRecordByHash(env, url.searchParams.get("hash"));
      }
      if (method === "POST" && path === "/api/record/delete") {
        return await deleteRecord(env, await request.json());
      }
      if (method === "GET" && path === "/api/records") {
        return await listRecords(env, url.searchParams);
      }
      if (method === "GET" && path === "/api/chiba/work") {
        return await listChibaWork(env, url.searchParams);
      }
      if (method === "POST" && path === "/api/chiba/done") {
        return await markChibaDone(env, await request.json());
      }
      if (method === "GET" && path === "/api/chiba") {
        return await apiGetChiba(env, url.searchParams.get("kind") || "");
      }
      if (method === "POST" && path === "/api/chiba") {
        return await apiSaveChiba(env, await request.json());
      }
      if (method === "POST" && path === "/api/chiba/match") {
        return await apiChibaMatch(env, await request.json());
      }
      if (method === "POST" && path === "/api/icd") {
        return await apiIcd(env, await request.json());
      }
      if (method === "POST" && path === "/api/report") {
        return await saveReport(env, await request.json(), authUser);
      }
      if (method === "GET" && path === "/api/reports") {
        return await listReports(env);
      }
      if (method === "POST" && path === "/api/report/read") {
        return await markReport(env, await request.json());
      }
      if (method === "POST" && path === "/api/report/delete") {
        return await deleteReport(env, await request.json());
      }
      if (method === "GET" && path === "/api/mailtpl") {
        return await apiGetMailTpl(env);
      }
      if (method === "POST" && path === "/api/mailtpl") {
        return await apiSaveMailTpl(env, await request.json());
      }
      if (method === "GET" && path === "/api/kcodes") {
        return await apiGetKcodes(env);
      }
      if (method === "POST" && path === "/api/kcodes") {
        return await apiSaveKcodes(env, await request.json());
      }
      if (method === "GET" && path === "/api/users") {
        return await apiListUsers(env);
      }
      if (method === "POST" && path === "/api/users") {
        return await apiSaveUser(env, await request.json());
      }
      if (method === "POST" && path === "/api/users/delete") {
        return await apiDeleteUser(env, await request.json());
      }

      return new Response("Not Found", { status: 404 });
    } catch (e) {
      return jsonError((e && e.message) || "サーバーエラー", 500);
    }
  },
};

