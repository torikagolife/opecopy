    "提供された登録術式リストの中から意味的に最も近いものを近い順に5件選びます。" +
    "リストにないコードは絶対に返さないでください。" +
    "reasonは選定理由を15文字以内で簡潔に。";

  const userPrompt =
    "# 入力された術式\n" + query + "\n\n" +
    "# 登録術式リスト (診療行為コード\t区分番号\t診療行為名称)\n" + listText;

  const out = await callOpenAI(
    env, MODEL_KCODE,
    [
      { role: "system", content: systemPrompt },
      { role: "user", content: userPrompt },
    ],
    1000, KCODE_SCHEMA
  );

  // コードをローカルの正データに逆引き(転記ミス・幻覚の防止)
  const results = [];
  const raw = (out.json && out.json.results) || [];
  for (const r of raw) {
    const row = byCode.get(String(r.code || "").trim());
    if (!row) continue;                       // リスト外のコードは捨てる
    results.push({ kcode: row[0], name: row[1], code: row[2], reason: String(r.reason || "") });
    if (results.length >= 5) break;
  }
  if (!results.length) return jsonError("該当する術式が見つかりませんでした。表現を変えて検索してください", 200);
  return jsonOk({ results: results, usage: out.usage || null });
}

