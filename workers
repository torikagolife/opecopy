function subRow(no,g,f,label){
  var list = subVals[no] || [];
  var v = (list[g] && list[g][f]) ? list[g][f] : "";
  var key = no + "|" + g + "|" + f;
  return '<div class="prodrow">' +
    '<span class="prodlbl">' + label + '</span>' +
    '<input type="text" data-sub="' + esc(key) + '" value="' + esc(v) + '">' +
    '<button class="btn mini" data-cpsub="' + esc(key) + '">\uD83D\uDCCB</button>' +
  '</div>';
}

function subGet(key){
  var a = key.split("|");
  var list = subVals[a[0]] || [];
  var row = list[parseInt(a[1],10)];
  return (row && row[a[2]]) ? row[a[2]] : "";
}

