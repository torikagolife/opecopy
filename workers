function renderSheetList(){
  if (!impParsed.length){
    $("sheetList").innerHTML = '<div class="hint">シートが見つかりません</div>';
    return;
  }
  var h = '<div class="hint">取込むシートを選んでね。シート名がマスタ名になります。' +
          '<b>A列に氏名だけが並ぶシートは医師マスタとして取込みます。</b><br>' +
          'IDは保存先の識別子です。同じIDのマスタがあると上書きされるので、分けたいシートは違うIDにしてください。</div>';
  var used = {};
  for (var i=0;i<impParsed.length;i++){
    var p = impParsed[i];
    var isDoc = (!p.items.length && p.doctors && p.doctors.length);
    var st = 0;
    for (var k=0;k<p.items.length;k++){ if (p.items[k].type === "sticker") st++; }
    var usable = p.items.length || isDoc;
    var dis = usable ? "" : " disabled";
    var meta;
    if (isDoc) meta = '\uD83D\uDC68‍⚕️ 医師マスタとして取込（' + p.doctors.length + ' 名）';
    else if (p.items.length) meta = p.items.length + ' 項目' + (st ? '（うち材料シール ' + st + '）' : '');
    else meta = '取込める行がありません';

    h += '<div class="sheetrow">' +
         '<input type="checkbox" data-sh="' + i + '"' + (usable?" checked":"") + dis + '>' +
         '<div style="flex:1;min-width:0">' +
           '<div class="sheetname">' + esc(p.sheet) + '</div>' +
           '<div class="sheetmeta">' + meta + '</div>';
    if (!isDoc && p.items.length){
      var idv = uniqueId(autoId(p.sheet), used);
      h += '<div class="idrow">ID <input type="text" class="idbox" data-id="' + i + '" value="' + esc(idv) + '"></div>';
    }
    h += '</div></div>';
  }
  $("sheetList").innerHTML = h;
  $("impRun").disabled = false;

  // ID欄を触ったら重複を知らせる
  var idbox = $("sheetList").querySelectorAll("input[data-id]");
  for (var b=0;b<idbox.length;b++) idbox[b].addEventListener("input", checkImportIds);
  checkImportIds();
}

async function runImport(){
  var boxes = $("sheetList").querySelectorAll("input[data-sh]");
  var picked = [];
  for (var i=0;i<boxes.length;i++){
    if (!boxes[i].checked) continue;
    var idx = parseInt(boxes[i].getAttribute("data-sh"),10);
    var rec = impParsed[idx];
    var idIn = $("sheetList").querySelector('input[data-id="' + idx + '"]');
    rec.useId = idIn ? sanitizeId(idIn.value) : "";      // 画面で指定されたIDを使う
    picked.push(rec);
  }
  if (!picked.length){ alert("シートを1つ以上選んでね"); return; }
  if (!checkImportIds()){ alert("IDが重複しています。別々に保存したいシートは違うIDにしてください"); return; }

  // 氏名リストのシートは医師マスタへ（既存に追加する形で統合）
  var docPicks = [], sheetPicks = [];
  for (var d=0;d<picked.length;d++){
    if (!picked[d].items.length && picked[d].doctors && picked[d].doctors.length) docPicks.push(picked[d]);
    else sheetPicks.push(picked[d]);
  }
  if (docPicks.length){
    var btnD = $("impRun");
    btnD.disabled = true; btnD.textContent = "⏳ 医師マスタ取込中…";
    try {
      var nowData = await api("/api/doctors");
      var merged = (nowData.names || []).slice();
      var before = merged.length;
      for (var q=0;q<docPicks.length;q++){
        for (var w=0;w<docPicks[q].doctors.length;w++) merged.push(docPicks[q].doctors[w]);
      }
      var saved = await api("/api/doctors", {
        method:"POST", headers:{"content-type":"application/json"},
        body: JSON.stringify({ names: merged })
      });
      var after = (saved.names || []).length;
      toast("医師マスタ: " + after + "名（" + (after - before) + "名追加）");
    } catch(e){
      alert("医師マスタの取込に失敗: " + e.message);
    }
    btnD.disabled = false; btnD.textContent = "取込む";
    if (!sheetPicks.length){ $("impModal").classList.add("hidden"); return; }
  }
  picked = sheetPicks;

  // 1シートだけ → そのまま編集画面へ（保存前に微修正できる）
  if (picked.length === 1){
    var p = picked[0];
    cur = { id: p.useId || autoId(p.sheet), name: p.sheet, items: p.items };
    curIsNew = true;
    $("impModal").classList.add("hidden");
    showEdit();
    toast("取込みました（未保存）— 内容を確認して\uD83D\uDCBE保存してね");
    return;
  }

  // 複数シート → まとめて保存
  var btn = $("impRun");
  btn.disabled = true;
  var okCount = 0, ngList = [];
  for (var j=0;j<picked.length;j++){
    var q = picked[j];
    btn.textContent = "⏳ 取込中 " + (j+1) + "/" + picked.length;
    try {
      await api("/api/master", {
        method:"POST", headers:{"content-type":"application/json"},
        body: JSON.stringify({ id: q.useId || autoId(q.sheet), name: q.sheet, items: q.items })
      });
      okCount++;
    } catch(e){
      ngList.push(q.sheet + "(" + e.message + ")");
    }
  }
  btn.disabled = false; btn.textContent = "取込む";
  $("impModal").classList.add("hidden");
  loadList();
  var msg = okCount + " 件を取込みました";
  if (ngList.length) msg += " / 失敗: " + ngList.join(", ");
  toast(msg);
}

