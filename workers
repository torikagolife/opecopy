function canvasToDataURL(canvas, maxDim, q){
  var sc = Math.min(1, maxDim / Math.max(canvas.width, canvas.height));
  if (sc >= 1) return canvas.toDataURL("image/jpeg", q);
  var t = document.createElement("canvas");
  t.width = Math.round(canvas.width * sc);
  t.height = Math.round(canvas.height * sc);
  t.getContext("2d").drawImage(canvas, 0, 0, t.width, t.height);
  return t.toDataURL("image/jpeg", q);
}

function tileCanvas(canvas, cols, rows, ov, maxDim, q){
  var out = [];
  var tw = canvas.width / cols, th = canvas.height / rows;
  var ox = tw * ov, oy = th * ov;
  for (var r=0;r<rows;r++){
    for (var c=0;c<cols;c++){
      var x0 = Math.max(0, c*tw - ox), y0 = Math.max(0, r*th - oy);
      var x1 = Math.min(canvas.width,  (c+1)*tw + ox);
      var y1 = Math.min(canvas.height, (r+1)*th + oy);
      var w = x1-x0, h = y1-y0;
      var sc = Math.min(1, maxDim / Math.max(w,h));
      var t = document.createElement("canvas");
      t.width = Math.round(w*sc); t.height = Math.round(h*sc);
      t.getContext("2d").drawImage(canvas, x0,y0,w,h, 0,0,t.width,t.height);
      out.push(t.toDataURL("image/jpeg", q));
    }
  }
  return out;
}

function normTitle(t){
  var parts = String(t||"").toLowerCase().split(" ");
  var o = [];
  for (var i=0;i<parts.length;i++){ var x = parts[i].trim(); if (x) o.push(x); }
  return o.join(" ");
}

// REF/SN/LOT が一致すれば同一シールとみなす(タイルの重なり分を統合)
function labelKey(l){
  var k = String(l.ref||"").trim() + "|" + String(l.sn||"").trim() + "|" + String(l.lot||"").trim();
  if (k === "||") return "T:" + normTitle(l.title);
  return k;
}

// 表記ゆれを落とした比較用タイトル
function normTitleKey(t){
  var s = String(t||"").toLowerCase(), out = "";
  for (var i=0;i<s.length;i++){
    var c = s.charAt(i);
    out += ((c>="a"&&c<="z")||(c>="0"&&c<="9")) ? c : " ";
  }
  var parts = out.split(" "), o = [];
  for (var j=0;j<parts.length;j++){
    var w = parts[j].trim();
    if (!w) continue;
    if (w === "equinox") w = "equinoxe";   // EQUINOX / EQUINOXE のゆれ
    o.push(w);
  }
  return o.join(" ");
}

// 短い編集距離(1文字違いのSN誤読を同一視するため)
function editDist(a,b){
  a = String(a||""); b = String(b||"");
  var m = a.length, n = b.length;
  if (Math.abs(m-n) > 2) return 99;
  var prev = [], cur = [], i, j;
  for (j=0;j<=n;j++) prev[j] = j;
  for (i=1;i<=m;i++){
    cur[0] = i;
    for (j=1;j<=n;j++){
      var cost = (a.charAt(i-1) === b.charAt(j-1)) ? 0 : 1;
      cur[j] = Math.min(prev[j]+1, cur[j-1]+1, prev[j-1]+cost);
    }
    for (var k=0;k<=n;k++) prev[k] = cur[k];
  }
  return prev[n];
}

// タイトルの単語集合の重なり(Jaccard)で近さを測る。
// strict schema導入で製品名の表記ゆれが増えたため、前方一致では拾えない
function titleSimilar(a, b){
  var ta = normTitleKey(a.title).split(" ");
  var tb = normTitleKey(b.title).split(" ");
  if (!ta.length || !tb.length) return false;
  var setA = {}, i;
  for (i=0;i<ta.length;i++) if (ta[i]) setA[ta[i]] = 1;
  var inter = 0, seen = {};
  for (i=0;i<tb.length;i++){
    var w = tb[i];
    if (!w || seen[w]) continue;
    seen[w] = 1;
    if (setA[w]) inter++;
  }
  var nA = 0; for (var k in setA) nA++;
  var nB = 0; for (var k2 in seen) nB++;
  var uni = nA + nB - inter;
  if (!uni) return false;
  return (inter / uni) >= 0.55;
}

function snOf(x){ return String(x.sn||"").trim().toUpperCase(); }
function refOf(x){ return String(x.ref||"").trim().toUpperCase(); }

// 同じシールの別観測か？
//   SNは個体固有なので最優先の識別子。ただし1〜2文字の読み違いは起こるため、
//   REFが一致していれば軽微なズレは同一個体とみなす。
function sameSticker(a, b){
  var sa = snOf(a), sb = snOf(b);
  if (sa && sb){
    var d = editDist(sa, sb);
    if (d === 0) return titleSimilar(a, b);
    var ra = refOf(a), rb = refOf(b);
    if (d <= 2 && ra && rb && ra === rb) return titleSimilar(a, b);
    return false;                       // SNが明確に違う = 別個体
  }
  if (!titleSimilar(a, b)) return false;
  var ra2 = refOf(a), rb2 = refOf(b);
  if (ra2 && rb2) return ra2 === rb2;   // REFが違えば別製品
  return true;
}

// 観測群から最頻値を採る(同数なら長い方)
function voteField(obs, f){
  var counts = {}, best = "", bestN = 0;
  for (var i=0;i<obs.length;i++){
    var v = String(obs[i][f]||"").trim();
    if (!v) continue;
    counts[v] = (counts[v]||0) + 1;
    if (counts[v] > bestN || (counts[v] === bestN && v.length > best.length)){ best = v; bestN = counts[v]; }
  }
  return best;
}

// 全観測をクラスタ化し、各項目を多数決で確定する
function consolidate(obs){
  var clusters = [];
  for (var i=0;i<obs.length;i++){
    var o = obs[i];
    if (!o || !o.title) continue;
    var placed = false;
    for (var c=0;c<clusters.length;c++){
      for (var m=0;m<clusters[c].length;m++){
        if (sameSticker(clusters[c][m], o)){ clusters[c].push(o); placed = true; break; }
      }
      if (placed) break;
    }
    if (!placed) clusters.push([o]);
  }
  var out = [];
  for (var k=0;k<clusters.length;k++){
    var g = clusters[k];
    var rec = {
      title: voteField(g,"title"),
      gtin:  voteField(g,"gtin"),
      ref:   voteField(g,"ref"),
      lot:   voteField(g,"lot"),
      sn:    voteField(g,"sn"),
      exp:   voteField(g,"exp"),
      maker: voteField(g,"maker"),
      gtinRaw: voteField(g,"gtinRaw"),
      seen:  g.length
    };
    // 採用した値と同じ観測からフラグを引き継ぐ
    rec.gtinNg = false; rec.expNg = false;
    for (var q=0;q<g.length;q++){
      if (rec.gtin && String(g[q].gtin||"") === rec.gtin && g[q].gtinNg) rec.gtinNg = true;
      if (rec.exp  && String(g[q].exp||"")  === rec.exp  && g[q].expNg)  rec.expNg  = true;
    }
    // 観測が1回だけ = 他のタイルで裏が取れていない
    rec.lowConf = (g.length === 1);
    // 同じ個体なのにSNの読みが揺れた = SNを鵜呑みにできない
    rec.snVaried = false;
    for (var v=0;v<g.length;v++){
      var sv = String(g[v].sn||"").trim().toUpperCase();
      if (sv && rec.sn && sv !== String(rec.sn).toUpperCase()) rec.snVaried = true;
    }
    out.push(rec);
  }
  return out;
}

