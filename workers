  if (!id) return jsonError("idが不正です", 400);
  const now = new Date().toISOString();
  await env.opecopy_db.prepare("UPDATE reports SET status='read', read_at=? WHERE id=?").bind(now, id).run();
  return jsonOk({ id: id, read: true });
}

async function deleteReport(env, body) {
