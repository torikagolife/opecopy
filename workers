// ============================================================
// ログインセッション (Cookie)
//   BASIC認証のダイアログはサイドバー(iframe)で出せないことがあるため、
//   画面上のログインフォーム + Cookie でも入れるようにする。
//   Authorizationヘッダ(BASIC)も従来どおり受け付ける。
// ============================================================
// ヘルプのリンク先(環境変数)を画面に差し込む。
//   未設定ならヘルプのリンクごと消すので、設定前でも画面が崩れない。
function applyHelpLink(html, url) {
  const u = String(url || "").trim();
  if (!u) return html.replace(/<a href="__HELP_URL__"[\s\S]*?<\/a>\s*/, "");
  return html.replace("__HELP_URL__", u.replace(/"/g, "%22"));
}

// 環境変数は貼り付け時に空白や改行が紛れ込みやすいので、読むときに落とす
function envStr(env, key) {
  return String((env && env[key]) || "").trim();
}

function sessSecret(env) {
  // 環境変数から鍵を作る。値そのものは外に出さない
  return "opecopy-session-v1|" + String((env && env.MASTER_PW) || "") + "|" + String((env && env.PW_OPE) || "");
}

async function makeSession(env, user) {
  const exp = Date.now() + SESS_DAYS * 86400000;
  const u = encodeURIComponent(String(user));
  const sig = await sha256Hex(sessSecret(env) + ":" + u + ":" + exp);
  return u + "." + exp + "." + sig;
}

// セッション文字列(user.exp.sig)を検証してユーザー名を返す。ダメなら空文字
async function verifySessionToken(tok, env) {
  const parts = String(tok || "").split(".");
  if (parts.length !== 3) return "";
  const u = parts[0], exp = parts[1], sig = parts[2];
  if (!(Number(exp) > Date.now())) return "";
  const want = await sha256Hex(sessSecret(env) + ":" + u + ":" + exp);
  if (want !== sig) return "";
  try { return decodeURIComponent(u); } catch (e) { return ""; }
}

async function readSession(request, env) {
  // Cookieが使えない環境(iframeでの遮断など)のために、ヘッダでも受け取れるようにする
  const hdr = String(request.headers.get("x-ope-sess") || "").trim();
  if (hdr) {
    const u = await verifySessionToken(hdr, env);
    if (u) return u;
  }
  const raw = String(request.headers.get("Cookie") || "");
  const m = raw.match(/(?:^|;\s*)ope_sess=([^;]+)/);
  if (!m) return "";
  const parts = String(m[1]).split(".");
  if (parts.length !== 3) return "";
  const u = parts[0], exp = parts[1], sig = parts[2];
  if (!(Number(exp) > Date.now())) return "";
  const want = await sha256Hex(sessSecret(env) + ":" + u + ":" + exp);
  if (want !== sig) return "";
  try { return decodeURIComponent(u); } catch (e) { return ""; }
}

// サイドバー(拡張のiframe)は別サイト扱いになるため SameSite=Lax だとCookieが送られない。
// None を指定し、Chromeの3rdパーティCookie廃止に備えて Partitioned も付ける
// (Partitionedを知らないブラウザは無視するだけなので害はない)。
const COOKIE_TAIL = "; Path=/; HttpOnly; Secure; SameSite=None; Partitioned; Max-Age=";

function sessionCookie(value, maxAgeSec) {
  return SESS_COOKIE + "=" + value + COOKIE_TAIL + maxAgeSec;
}

// IDとパスワードを名簿・非常口の順に照合する
async function verifyCredential(env, id, pw) {
  const uid = String(id || "").trim();
  if (!uid) return false;
  const mid = envStr(env, "MASTER_ID");
  const mpw = envStr(env, "MASTER_PW");
  if (mid && mpw && uid === mid && String(pw).trim() === mpw) {
    return true;   // 非常口(環境変数)での照合
  }
  const users = await loadUsers(env);
  for (const u of users) {
    if (u && u.id === uid) {
      const h = await userHash(uid, String(pw));
      return h === u.hash;
    }
  }
  return false;
}

async function apiSessionLogin(env, body) {
  const b = body || {};
  const id = String(b.id || "").trim();
  const pw = String(b.password || "");
  if (!id || !pw) return jsonError("IDとパスワードを入力してください", 400);
  const ok = await verifyCredential(env, id, pw);
  if (!ok) return jsonError("IDまたはパスワードが違います", 401);
  const tok = await makeSession(env, id);
  // tokenも返す。Cookieが遮断される環境ではこれを保存してヘッダで送る
  return new Response(JSON.stringify({ ok: true, user: id, token: tok }), {
    status: 200,
    headers: {
      "content-type": "application/json; charset=utf-8",
      "Set-Cookie": sessionCookie(tok, SESS_DAYS * 86400),
    },
  });
}

function apiLogout() {
  const h = new Headers({ "content-type": "application/json; charset=utf-8" });
  h.append("Set-Cookie", sessionCookie("", 0));
  h.append("Set-Cookie", adminCookie("", 0));   // 管理画面のゲートも同時に閉じる
  return new Response(JSON.stringify({ ok: true }), { status: 200, headers: h });
}

