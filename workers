async function exportChiba(){
  try {
    await ensureXLSX();
    if (!chRows.length){ alert("書き出すものがありません"); return; }
    var aoa = [[chLabel()]];
    for (var i=0;i<chRows.length;i++) aoa.push([chRows[i]]);
    var wb = window.XLSX.utils.book_new();
    var ws = window.XLSX.utils.aoa_to_sheet(aoa);
    ws["!cols"] = [{wch:52}];
    window.XLSX.utils.book_append_sheet(wb, ws, "chiba-" + chKind);
    window.XLSX.writeFile(wb, "オペコピ_千葉大" + chLabel() + "リスト.xlsx");
    toast("書き出しました");
  } catch(e){
    alert("書き出しに失敗: " + e.message);
  }
}

async function onChFile(ev){
  var f = ev.currentTarget.files && ev.currentTarget.files[0];
  ev.currentTarget.value = "";
  if (!f) return;
  try {
    await ensureXLSX();
    var buf = await f.arrayBuffer();
    var wb = window.XLSX.read(buf, { type:"array" });
    var ws = wb.Sheets[wb.SheetNames[0]];
    var rows = window.XLSX.utils.sheet_to_json(ws, { header:1, defval:"" });
    var out = [];
    var seen = {};
    var dup = 0;
    for (var i=0;i<rows.length;i++){
      var v = String((rows[i] && rows[i][0]) == null ? "" : rows[i][0]).trim();
      if (!v) continue;
      if (i === 0 && (v === "病名" || v === "術式")) continue;   // 見出し行
      if (seen[v]){ dup++; continue; }
      seen[v] = 1;
      out.push(v);
    }
    if (!out.length){ alert("取り込める行がありませんでした。A列に1行1語で入れてください。"); return; }
    chPending = out;
    var diff = out.length - chRows.length;
    var diffTxt = diff === 0 ? "件数は変わりません"
      : (diff > 0 ? (diff + " 件 増えます") : ((-diff) + " 件 減ります"));
    var h = '<div style="font-weight:700;margin-bottom:6px">取込内容の確認（' + chLabel() + '）</div>' +
      '<div>現在 <b>' + chRows.length + '</b> 件 → 取込後 <b>' + out.length + '</b> 件（' + diffTxt + '）</div>';
    if (dup) h += '<div style="color:#8a919c;font-size:13px;margin-top:4px">※ 同じ語が ' + dup + ' 件あったので1つにまとめました</div>';
    h += '<div style="font-size:12.5px;color:#8a919c;margin-top:6px">先頭3件: ' + esc(out.slice(0,3).join(" / ")) + '</div>' +
      '<div class="bar" style="margin-top:10px">' +
      '<button class="btn primary" id="chCommit">この内容で入れ替える</button>' +
      '<button class="btn" id="chCancel">やめる</button></div>';
    $("chPreview").innerHTML = h;
    $("chPreview").classList.remove("hidden");
    $("chCommit").addEventListener("click", commitChiba);
    $("chCancel").addEventListener("click", function(){
      chPending = null;
      $("chPreview").classList.add("hidden");
    });
  } catch(e){
    alert("読み込みに失敗: " + e.message);
  }
}

async function commitChiba(){
  if (!chPending) return;
  var btn = $("chCommit");
  btn.disabled = true; btn.textContent = "保存中…";
  try {
    var r = await api("/api/chiba", {
      method:"POST", headers:{"content-type":"application/json"},
      body: JSON.stringify({ kind: chKind, rows: chPending })
    });
    toast(r.count + " 件を登録しました");
    chPending = null;
    $("chPreview").classList.add("hidden");
    await loadChiba();
  } catch(e){
    alert("保存に失敗: " + e.message);
    btn.disabled = false; btn.textContent = "この内容で入れ替える";
  }
}

async function resetChiba(){
  if (!confirm("取り込んだ" + chLabel() + "リストを消して、内蔵の初期値に戻します。よろしい？")) return;
  try {
    await api("/api/chiba", {
      method:"POST", headers:{"content-type":"application/json"},
