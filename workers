// Excel取込
// ============================================================
var xlsxLoading = null;
function ensureXLSX(){
  if (window.XLSX) return Promise.resolve();
  if (xlsxLoading) return xlsxLoading;
  var urls = [
    "https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js",
    "https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"
  ];
  xlsxLoading = new Promise(function(resolve, reject){
    var i = 0;
    function tryNext(){
      if (i >= urls.length){
        xlsxLoading = null;
        reject(new Error("Excelライブラリの読み込みに失敗しました(ネットワーク制限の可能性)"));
        return;
      }
      var s = document.createElement("script");
      s.src = urls[i++];
      s.onload = function(){ resolve(); };
      s.onerror = function(){ tryNext(); };
      document.head.appendChild(s);
    }
    tryNext();
  });
  return xlsxLoading;
}

// [[...]] を取り出す（正規表現を使わない：テンプレートリテラル内のバックスラッシュ事故防止）
function extractTokens(s){
  var out = [], i = 0, str = String(s||"");
  while (true){
    var a = str.indexOf("[[", i);
    if (a < 0) break;
    var b = str.indexOf("]]", a+2);
    if (b < 0) break;
    var t = str.slice(a+2, b).trim();
    if (t) out.push(t);
    i = b + 2;
  }
  return out;
}

// C列(出力内容) / E列(読取り文字) / F列(出力対象) から種別を判定
function classifyRow(out, kw, rule){
  var o = String(out||"").trim();
  if (o.indexOf("シール") >= 0) return "sticker";
  var toks = extractTokens(o);
  if (toks.length >= 2) return "choice";
  if (toks.length === 1) return "fixed";
  if (o === "確認" || o.indexOf("確認") >= 0) return "confirm";
  if (String(kw||"").trim() || String(rule||"").trim()) return "ocr";
  return "unset";
}

function looksLikeHeader(r){
  var j = String(r[1]||"") + "|" + String(r[2]||"") + "|" + String(r[4]||"") + "|" + String(r[5]||"");
  return j.indexOf("JOANR") >= 0 || j.indexOf("出力内容") >= 0 ||
         j.indexOf("読取り") >= 0 || j.indexOf("出力対象") >= 0;
}

// 【…】で終わる行はセクション見出しとみなす。
// 「★【千葉大用】」のように前に飾りが付いていても拾えるようにしている。
function isSectionLabel(lab){
  var s = String(lab||"").trim();
  var a = s.indexOf("【");
  var b = s.lastIndexOf("】");
  return a >= 0 && b === s.length - 1 && b > a + 1;
}

function sectionNameOf(lab){
  var s = String(lab||"").trim();
  var a = s.indexOf("【");
  var b = s.lastIndexOf("】");
  return s.slice(a + 1, b);
}

// 1シート → items配列
function sheetToItems(rows){
  var items = [];
  var section = "";
  for (var r=0;r<rows.length;r++){
    var row = rows[r] || [];
    if (r === 0 && looksLikeHeader(row)) continue;
    var lab  = String(row[1]==null?"":row[1]).trim();
    var out  = String(row[2]==null?"":row[2]).trim();
    // row[3] = 読取りフォーカス列 → 廃止につき読まない
    var kw   = String(row[4]==null?"":row[4]).trim();
    var rule = String(row[5]==null?"":row[5]).trim();
    var sug  = String(row[6]==null?"":row[6]).trim();   // G列: 候補リスト
    var mkw  = String(row[7]==null?"":row[7]).trim();   // H列: 材料キーワード
    var nkw  = String(row[8]==null?"":row[8]).trim();   // I列: 除外キーワード
    if (!lab) continue;
    if (isSectionLabel(lab)){ section = sectionNameOf(lab); continue; }

    var type = classifyRow(out, kw, rule);
    var it = { no: items.length+1, section: section, label: lab, type: type };
    if (type === "fixed"){
      var t1 = extractTokens(out);
      it.value = t1.length ? t1[0] : out;
    }
    if (type === "choice"){
      it.choices = extractTokens(out);
    }
    if (type === "ocr" || type === "choice"){
      if (kw) it.keyword = kw;
      if (rule) it.rule = rule;
      if (sug === "kcode") it.suggest = "kcode";
      else if (sug === "icd10") it.suggest = "icd10";
      else if (sug === "chiba-byomei") it.suggest = "chiba-byomei";
      else if (sug === "chiba-jutsushiki") it.suggest = "chiba-jutsushiki";
    }
    if (type === "sticker"){
      it.source = "label";
      it.matKeywords = splitList(mkw);
      it.ngKeywords = splitList(nkw);
    }
    items.push(it);
  }
  return items;
}

// A列だけに氏名が並ぶシート = 医師マスタとみなす
function sheetToDoctors(rows){
  var names = [];
  for (var i=0;i<rows.length;i++){
    var r = rows[i] || [];
    var a = String(r[0]==null?"":r[0]).trim();
    var other = "";
    for (var c=1;c<6;c++) other += String(r[c]==null?"":r[c]).trim();
    if (other) return [];            // B〜F列に中身がある = 用紙マスタなので対象外
    if (!a) continue;
    if (i === 0 && (a.indexOf("氏名") >= 0 || a.indexOf("医師") >= 0 || a.indexOf("名前") >= 0)) continue;
    names.push(a);
  }
  return names.length >= 3 ? names : [];
}

// 取込前にIDの重複を確かめる
function checkImportIds(){
  var boxes = $("sheetList").querySelectorAll("input[data-id]");
  var seen = {}, dup = false;
  for (var i=0;i<boxes.length;i++){
    var v = sanitizeId(boxes[i].value);
    if (!v || seen[v]) dup = true;
    seen[v] = 1;
  }
  var box = $("sheetList").querySelectorAll("input[data-id]");
  var seen2 = {};
  for (var j=0;j<box.length;j++){
    var v2 = sanitizeId(box[j].value);
    var bad = (!v2 || seen2[v2]);
    box[j].className = bad ? "idbox ng" : "idbox";
    seen2[v2] = 1;
  }
  var warn = $("impIdWarn");
  if (warn) warn.style.display = dup ? "block" : "none";
  $("impRun").disabled = dup;
  return !dup;
}

