      ctrl += subRow(no,g,"maker","メーカー名");
      ctrl += subRow(no,g,"name","商品名");
      ctrl += subRow(no,g,"lot","ロットNo");
      var rf = [];
      if (list[g].sn)  rf.push("SN " + esc(list[g].sn));
      if (list[g].exp) rf.push("EXP " + esc(list[g].exp));
      if (rf.length) ctrl += '<div class="prodref">（参考）' + rf.join("　") + '</div>';
      ctrl += '</div>';
