  var tag = "";
  if (type === "fixed")   tag = '<span class="tag fx">固定</span>';
  if (type === "sticker") tag = '<span class="tag st">シール</span>';
  if (type === "confirm") tag = '<span class="tag cf">要確認</span>';
  if (type === "unset")   tag = '<span class="tag">未設定</span>';

  var ctrl = "";
  if (type === "choice"){
    var cs = it.choices || [];
    ctrl = '<select data-no="' + esc(no) + '"><option value=""></option>';
    for (var c=0;c<cs.length;c++){
      ctrl += '<option value="' + esc(cs[c]) + '"' + (String(cs[c]) === String(val) ? " selected" : "") + '>' + esc(cs[c]) + '</option>';
    }
