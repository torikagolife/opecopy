// 氏名比較用の正規化(空白を除く)
function normName(s) {
  const t = String(s == null ? "" : s);
  let out = "";
  for (let i = 0; i < t.length; i++) {
    const c = t.charAt(i);
    if (c === " " || c === "\u3000" || c === "\t") continue;
    out += c;
  }
  return out;
}

function levDist(a, b) {
  const m = a.length, n = b.length;
  if (Math.abs(m - n) > 3) return 99;
  let prev = [], cur = [];
  for (let j = 0; j <= n; j++) prev[j] = j;
  for (let i = 1; i <= m; i++) {
    cur[0] = i;
    for (let j = 1; j <= n; j++) {
      const cost = a.charAt(i - 1) === b.charAt(j - 1) ? 0 : 1;
      cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost);
    }
    for (let k = 0; k <= n; k++) prev[k] = cur[k];
  }
  return prev[n];
}

// 読み取った氏名を医師マスタの最も近い名前へ寄せる(1〜2文字の誤読を吸収)
function snapOneName(text, names) {
  const t = normName(text);
  if (!t) return { value: text, from: null };
  let best = null, bestD = 99;
  for (const n of names) {
    const d = levDist(t, normName(n));
    if (d < bestD) { bestD = d; best = n; }
  }
  if (best === null) return { value: text, from: null };
  if (bestD === 0) return { value: best, from: null };       // 表記を揃えるだけ
  const allow = t.length <= 3 ? 1 : 2;                        // 短い名前ほど厳しく
  if (bestD <= allow) return { value: best, from: text };     // 補正した
  return { value: text, from: null };                         // 遠すぎるので触らない
}

// 「A、B」形式の複数名にも対応
function snapNames(value, names) {
  if (!value || !names.length) return { value: value, fixes: [] };
  const parts = String(value).split("、");
  const out = [], fixes = [];
  for (const p of parts) {
    const t = p.trim();
    if (!t) continue;
    const r = snapOneName(t, names);
    out.push(r.value);
    if (r.from) fixes.push(r.from + " → " + r.value);
  }
  return { value: out.join("、"), fixes: fixes };
}

function normalizeType(t) {
  const ok = ["ocr", "choice", "fixed", "sticker", "confirm", "unset"];
  const s = String(t || "").trim();
  return ok.indexOf(s) >= 0 ? s : "unset";
}

function toArray(v) {
  if (Array.isArray(v)) {
    const out = [];
    for (const x of v) {
      const s = String(x == null ? "" : x).trim();
      if (s) out.push(s);
    }
    return out;
  }
  const s = String(v == null ? "" : v);
  if (!s.trim()) return [];
  const parts = s.split("、").join(",").split(",");
  const out = [];
  for (const p of parts) {
    const t = p.trim();
    if (t) out.push(t);
  }
  return out;
}

function sanitizeId(s) {
  const lower = String(s || "").trim().toLowerCase();
  let out = "";
  for (let i = 0; i < lower.length; i++) {
    const c = lower.charAt(i);
    const isNum = c >= "0" && c <= "9";
    const isAl = c >= "a" && c <= "z";
    if (isNum || isAl || c === "-" || c === "_") out += c;
  }
  return out.slice(0, 60);
}

function jsonOk(obj) {
  return new Response(JSON.stringify(Object.assign({ ok: true }, obj)), {
    headers: { "content-type": "application/json; charset=utf-8" },
  });
}

function jsonError(message, status) {
  return new Response(JSON.stringify({ ok: false, error: message }), {
    status: status || 400,
    headers: { "content-type": "application/json; charset=utf-8" },
  });
}

