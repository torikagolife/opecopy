// パスワードはIDを混ぜてハッシュ化する（同じパスワードでも別の値になる）
async function userHash(id, pw) {
  return await sha256Hex("opecopy:user:v1:" + String(id) + ":" + String(pw));
}

function decodeBasic(request) {
  const h = String(request.headers.get("Authorization") || "");
  if (h.slice(0, 6).toLowerCase() !== "basic ") return null;
  let txt = "";
  try {
    const bin = atob(h.slice(6).trim());
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    txt = new TextDecoder("utf-8").decode(bytes);   // 日本語IDでも壊れないように
  } catch (e) {
    return null;
  }
  const p = txt.indexOf(":");
  if (p < 0) return null;
  return { id: txt.slice(0, p), pw: txt.slice(p + 1) };
}

async function basicGate(request, env) {
  const users = await loadUsers(env);
  const hasMaster = !!(envStr(env, "MASTER_ID") && envStr(env, "MASTER_PW"));
  // 名簿も非常口も無い＝まだ設定前。締め出さないよう素通しにする
  if (!users.length && !hasMaster) return { ok: true, user: "" };

  // ① ログインフォームで発行したCookie
  const sess = await readSession(request, env);
  if (sess) {
    if (hasMaster && sess === envStr(env, "MASTER_ID")) return { ok: true, user: sess };
    for (const u of users) if (u && u.id === sess) return { ok: true, user: sess };
    // 名簿から消された利用者のCookieは無効
  }

  // ② Authorizationヘッダ(BASIC)
  const cred = decodeBasic(request);
  if (!cred || !cred.id) return { ok: false, user: "" };

  if (hasMaster && cred.id.trim() === envStr(env, "MASTER_ID") && cred.pw.trim() === envStr(env, "MASTER_PW")) {
    return { ok: true, user: cred.id.trim() };
  }
  for (const u of users) {
    if (u && u.id === cred.id) {
      const h = await userHash(cred.id, cred.pw);
      if (h === u.hash) return { ok: true, user: cred.id };
      return { ok: false, user: "" };
    }
  }
  return { ok: false, user: "" };
}

