// 術式マスタを取り出す。KVに登録があればそれを使い、無ければ上の初期値を使う。
//   → 取込に失敗しても業務が止まらないようにするための二段構え
async function getKcodeData(env) {
  if (env && env.FORM_KV) {
    try {
      const raw = await env.FORM_KV.get(KCODE_KEY, { cacheTtl: 300 });
      if (raw) {
        const obj = JSON.parse(raw);
        const rows = Array.isArray(obj.rows) ? obj.rows : null;
        if (rows && rows.length) return rows;
      }
    } catch (e) {
      // 壊れていたら初期値に落とす
    }
  }
  return KCODE_DATA;
}

function kcodeMap(rows) {
  const m = new Map();
  for (const r of rows) m.set(String(r[2]), r);
  return m;
}

// Excelから来た行を整える。3列に満たない行・空行は捨て、レセ電コードの重複も除く
function normalizeKcodeRows(rows) {
  const out = [];
  const seen = new Set();
  for (const r of rows || []) {
    if (!Array.isArray(r)) continue;
    const kcode = String(r[0] == null ? "" : r[0]).trim();
    const name  = String(r[1] == null ? "" : r[1]).trim();
    const code  = String(r[2] == null ? "" : r[2]).trim();
    if (!kcode || !name || !code) continue;
    if (seen.has(code)) continue;
    seen.add(code);
    out.push([kcode, name, code]);
  }
  return out;
}

async function apiGetKcodes(env) {
  const rows = await getKcodeData(env);
  let stored = false;
  if (env && env.FORM_KV) {
    try { stored = !!(await env.FORM_KV.get(KCODE_KEY)); } catch (e) {}
  }
  // stored=false なら「コード内の初期値を表示している」という意味
  return jsonOk({ rows: rows, count: rows.length, stored: stored, builtinCount: KCODE_DATA.length });
}

async function apiSaveKcodes(env, body) {
  if (!env.FORM_KV) return jsonError("KVバインディング FORM_KV が設定されていません", 500);
  const b = body || {};
  // reset:true なら登録を消してコード内の初期値に戻す
  if (b.reset) {
    await env.FORM_KV.delete(KCODE_KEY);
    return jsonOk({ reset: true, count: KCODE_DATA.length });
  }
  const rows = normalizeKcodeRows(b.rows);
  if (!rows.length) return jsonError("取り込める行がありません(3列すべて埋まった行が必要です)", 400);
  await env.FORM_KV.put(KCODE_KEY, JSON.stringify({ rows: rows, updatedAt: new Date().toISOString() }));
  return jsonOk({ saved: true, count: rows.length });
}

