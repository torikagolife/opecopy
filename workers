// QR二段階認証（スマホで承認するまで本体を使わせない）
// ============================================================
var QR_KEY = "opecopy_qr";
var qrPoll = null, qrTimer = null, qrCurToken = "";

// 認証トークンと同じく、localStorageが使えない環境でもメモリで持ちこたえる
var memQr = "";
function getQrToken(){
  try { var v = localStorage.getItem(QR_KEY); if (v) return v; } catch(e){}
  return memQr;
}
function setQrToken(v){ memQr = v || ""; try { localStorage.setItem(QR_KEY, v); } catch(e){} }
function clearQrToken(){ memQr = ""; try { localStorage.removeItem(QR_KEY); } catch(e){} }

// QR描画ライブラリ(必要になった時だけ読む)
var qrLibLoading = null;
function ensureQrLib(){
  if (window.qrcode) return Promise.resolve();
  if (qrLibLoading) return qrLibLoading;
  qrLibLoading = new Promise(function(resolve, reject){
    var el = document.createElement("script");
    el.src = "https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.2/qrcode.min.js";
    el.onload = function(){ resolve(); };
    el.onerror = function(){ qrLibLoading = null; reject(new Error("QRライブラリの読み込みに失敗しました")); };
    document.head.appendChild(el);
  });
  return qrLibLoading;
}

function qrStopWatch(){
  if (qrPoll){ clearInterval(qrPoll); qrPoll = null; }
  if (qrTimer){ clearTimeout(qrTimer); qrTimer = null; }
}

function qrSetState(txt, ng){
  var el = $("qrState");
  if (!el) return;
  el.className = ng ? "ng" : "";
  el.innerHTML = ng ? esc(txt) : ('<span class="qrdot"></span>' + esc(txt));
}

// QRを発行して表示し、スマホの承認を待つ
async function startQrGate(){
  qrStopWatch();
  $("qrOverlay").classList.remove("hidden");
  $("qrBox").innerHTML = '<span class="qr-note">準備中…</span>';
  $("qrCode").textContent = "------";
  qrSetState("QRを準備しています…");
  try {
    await ensureQrLib();
    var d = await api("/api/qr/new", { method:"POST", headers:{"content-type":"application/json"}, body:"{}" });
    if (d.required === false){ finishQrGate(); return; }   // 設定が無効なら素通り
    qrCurToken = d.token;
    $("qrCode").textContent = d.code;

    var url = location.origin + "/pair?t=" + d.token;
    var qr = window.qrcode(0, "M");
    qr.addData(url);
    qr.make();
    $("qrBox").innerHTML = qr.createImgTag(6, 0);

    qrSetState("読み取りを待っています…");
    qrPoll = setInterval(checkQrOnce, 2000);
    qrTick = 0;
    qrTimer = setTimeout(function(){
      qrStopWatch();
      qrSetState("QRの期限が切れました。再表示してください。", true);
    }, (d.ttl || 180) * 1000);
  } catch(e){
    qrSetState((e && e.message) || "QRを表示できませんでした", true);
  }
}

var qrTick = 0;
async function checkQrOnce(){
  if (!qrCurToken) return;
  qrTick++;
  try {
    var res = await fetch("/api/qr/status?t=" + encodeURIComponent(qrCurToken), {
      headers: { "x-ope-auth": getToken() }
    });
    var d = await res.json();
    if (!d.ok) return;
    if (d.status === "approved"){
      qrStopWatch();
      if (d.session) setQrToken(d.session);
      qrSetState("認証されました");
      setTimeout(finishQrGate, 500);
    } else if (d.status === "waiting"){
      // 読み取り済みでも反映まで最大10秒かかることがあるので、その旨を出す
      qrSetState(qrTick > 5 ? "読み取り後、数秒で進みます…" : "読み取りを待っています…");
    } else if (d.status === "expired"){
      qrStopWatch();
      qrSetState("QRの期限が切れました。再表示してください。", true);
    }
  } catch(e){ /* 一時的な通信断は無視して次の巡回で拾う */ }
}

function finishQrGate(){
  qrStopWatch();
  $("qrOverlay").classList.add("hidden");
}

// ログイン後に呼ぶ。QRが不要な設定 or 承認済みなら何もしない
async function ensureQrGate(){
  try {
    var r = await fetch("/api/qrinfo");
    var d = await r.json();
    if (!d.ok || !d.required) return;      // QR_ENABLED=false なら無効
  } catch(e){ return; }

  // 前回のセッションが残っていても、サーバー側で生きているか確かめる
  // （期限切れのまま画面が進んで、読み取り実行で初めて弾かれるのを防ぐ）
  if (getQrToken()){
    try {
      var res = await fetch("/api/qr/check", {
        headers: { "x-ope-auth": getToken(), "x-ope-qr": getQrToken() }
      });
      var c = await res.json();
      if (c.ok && c.valid) return;         // まだ有効
    } catch(e){ return; }                  // 通信できない時は止めない
    clearQrToken();
  }
  startQrGate();
}

