// 見出し行かどうかを判定する（3列目が数字でなければ見出しとみなす）
function kcIsHeader(row){
  var c = String(row[2] == null ? "" : row[2]).trim();
  if (!c) return true;
  return !/^[0-9]+$/.test(c);
}

async function onKcFile(ev){
  var f = ev.currentTarget.files && ev.currentTarget.files[0];
  ev.currentTarget.value = "";
  if (!f) return;
  try {
    await ensureXLSX();
    var buf = await f.arrayBuffer();
    var wb = window.XLSX.read(buf, { type:"array" });
    var ws = wb.Sheets[wb.SheetNames[0]];
    var rows = window.XLSX.utils.sheet_to_json(ws, { header:1, defval:"" });
    var out = [];
    var skipped = 0;
    var seen = {};
    for (var i=0;i<rows.length;i++){
      var r = rows[i] || [];
      if (i === 0 && kcIsHeader(r)) continue;             // 見出し行を読み飛ばす
      var a = String(r[0] == null ? "" : r[0]).trim();
      var b = String(r[1] == null ? "" : r[1]).trim();
      var c = String(r[2] == null ? "" : r[2]).trim();
      if (!a && !b && !c) continue;                       // 空行は数えない
      if (!a || !b || !c){ skipped++; continue; }         // 欠けた行
      if (seen[c]){ skipped++; continue; }                // レセ電コードの重複
      seen[c] = 1;
      out.push([a,b,c]);
    }
    if (!out.length){
      alert("取り込める行がありませんでした。列の並びが 区分番号 / 名称 / レセ電コード になっているか確認してください。");
      return;
    }
    kcPending = out;
    var diff = out.length - kcRows.length;
    var diffTxt = diff === 0 ? "件数は変わりません"
      : (diff > 0 ? (diff + " 件 増えます") : ((-diff) + " 件 減ります"));
    var h = '<div style="font-weight:700;margin-bottom:6px">取込内容の確認</div>' +
      '<div>現在 <b>' + kcRows.length + '</b> 件 → 取込後 <b>' + out.length + '</b> 件（' + diffTxt + '）</div>';
    if (skipped) h += '<div style="color:#e5534b;font-size:13px;margin-top:4px">※ ' + skipped + ' 行は列が欠けているか重複のため取り込みません</div>';
    h += '<div style="font-size:12.5px;color:#8a919c;margin-top:6px">先頭3件: ' +
      esc(out.slice(0,3).map(function(x){ return x[0] + " " + x[1]; }).join(" / ")) + '</div>' +
      '<div class="bar" style="margin-top:10px">' +
      '<button class="btn primary" id="kcCommit">この内容で入れ替える</button>' +
      '<button class="btn" id="kcCancel">やめる</button></div>';
    $("kcPreview").innerHTML = h;
    $("kcPreview").classList.remove("hidden");
    $("kcCommit").addEventListener("click", commitKcodes);
    $("kcCancel").addEventListener("click", function(){
      kcPending = null;
      $("kcPreview").classList.add("hidden");
    });
  } catch(e){
    alert("読み込みに失敗: " + e.message);
  }
}

async function commitKcodes(){
  if (!kcPending) return;
  var btn = $("kcCommit");
  btn.disabled = true; btn.textContent = "保存中…";
  try {
    var r = await api("/api/kcodes", {
