async function loadRecords(reset){
  if (reset){ recRows = []; recOffset = 0; $("recBody").innerHTML = '<div class="empty">読込中…</div>'; }
  try {
    var r = await api(recQuery(recOffset));
    var got = r.records || [];
    recRows = recRows.concat(got);
    recOffset += got.length;
    renderRecords();
    $("recMore").disabled = (got.length < REC_PAGE);
  } catch(e){
    $("recBody").innerHTML = '<div class="empty">読み込みに失敗しました: ' + esc(e.message) + '</div>';
  }
}

function renderRecords(){
  if (!recRows.length){
    $("recBody").innerHTML = '<div class="empty">該当する症例がありません</div>';
    $("recCount").textContent = "";
    return;
  }
  var h = '<table class="list"><tr>' +
    '<th>ID</th><th>患者ID</th><th>手術日</th><th>用紙</th><th>状態</th><th>読取日時</th><th>読取者</th><th></th></tr>';
  for (var i=0;i<recRows.length;i++){
    var r = recRows[i];
    h += '<tr data-rec="' + esc(r.id) + '" style="cursor:pointer">' +
      '<td>' + esc(r.id) + '</td>' +
      '<td>' + esc(r.patient_no || "") + '</td>' +
      '<td>' + esc(r.surgery_date || "") + '</td>' +
      '<td>' + esc(r.master_name || r.master_id || "") + '</td>' +
      '<td>' + esc(r.status || "") + '</td>' +
      '<td>' + esc(recFmt(r.created_at)) + '</td>' +
      '<td>' + esc(r.created_by || "") + '</td>' +
      '<td><button class="btn mini danger" data-recdel="' + esc(r.id) + '">削除</button></td>' +
    '</tr>';
  }
  h += '</table>';
  $("recBody").innerHTML = h;
  $("recCount").textContent = recRows.length + " 件";

  var trs = $("recBody").querySelectorAll("tr[data-rec]");
  for (var t=0;t<trs.length;t++){
    trs[t].addEventListener("click", function(ev){
      if (ev.target && ev.target.getAttribute("data-recdel")) return;   // 削除ボタンは別処理
      showRecord(ev.currentTarget.getAttribute("data-rec"));
    });
  }
  var dels = $("recBody").querySelectorAll("button[data-recdel]");
  for (var q=0;q<dels.length;q++){
    dels[q].addEventListener("click", function(ev){
      ev.stopPropagation();
      delRecord(ev.currentTarget.getAttribute("data-recdel"));
    });
  }
}

// UTCで保存されているのでJSTに直して表示する
function recFmt(iso){
  if (!iso) return "";
  var d = new Date(iso);
  if (isNaN(d.getTime())) return String(iso);
  function z(n){ return (n<10?"0":"") + n; }
  return d.getFullYear() + "/" + z(d.getMonth()+1) + "/" + z(d.getDate()) +
    " " + z(d.getHours()) + ":" + z(d.getMinutes());
}

async function showRecord(id){
  var box = $("recDetail");
  box.classList.remove("hidden");
  box.innerHTML = '<div class="empty">読込中…</div>';
  try {
    var r = await api("/api/record?id=" + encodeURIComponent(id));
    var rec = r.record || {};
    var pay = {};
    try { pay = JSON.parse(rec.payload || "{}"); } catch(e){}
    var fs = pay.fields || [];
    var h = '<div style="font-weight:700;margin-bottom:8px">症例 #' + esc(rec.id) +
      '（患者ID ' + esc(rec.patient_no || "-") + ' ／ ' + esc(rec.surgery_date || "-") + '）</div>';
    h += '<table class="list"><tr><th style="width:44px">No</th><th>項目</th><th>値</th></tr>';
    for (var i=0;i<fs.length;i++){
      h += '<tr><td>' + esc(fs[i].no) + '</td><td>' + esc(fs[i].label) + '</td><td>' + esc(fs[i].value) + '</td></tr>';
    }
    h += '</table>';
    // 材料（シール）は入れ子なので別に出す
    var mats = pay.materials || {};
    var mk = Object.keys(mats);
    var mh = "";
    for (var m=0;m<mk.length;m++){
      var rows = mats[mk[m]] || [];
      for (var g=0;g<rows.length;g++){
        var row = rows[g];
        if (!row) continue;
        if (!row.catalog && !row.maker && !row.name && !row.lot) continue;   // 空は出さない
        mh += '<tr><td>' + esc(mk[m]) + '</td><td>' + esc(row.name || "") + '</td><td>' +
          esc(row.maker || "") + '</td><td>' + esc(row.catalog || "") + '</td><td>' + esc(row.lot || "") + '</td></tr>';
      }
    }
    if (mh){
      h += '<div style="font-weight:700;margin:12px 0 6px">材料</div>' +
        '<table class="list"><tr><th>項目No</th><th>商品名</th><th>メーカー</th><th>カタログNo</th><th>ロット</th></tr>' + mh + '</table>';
    }
    box.innerHTML = h;
    box.scrollIntoView({ behavior: "smooth", block: "nearest" });
  } catch(e){
    box.innerHTML = '<div class="empty">読み込みに失敗しました: ' + esc(e.message) + '</div>';
  }
}

