function saveLabelHit(label, list){
  var s = String(label == null ? "" : label);
  for (var i = 0; i < list.length; i++){ if (s.indexOf(list[i]) >= 0) return true; }
  return false;
}
function isSavePatientId(label){ return saveLabelHit(label, SAVE_PATIENT_ID_LABELS); }
function isSaveBump(label){ return saveLabelHit(label, SAVE_BUMP_LABELS); }
function isSaveSurgeryDate(label){ return saveLabelHit(label, SAVE_SURGERY_DATE_LABELS); }
function isSaveName(label){ return saveLabelHit(label, SAVE_NAME_LABELS); }
function isSaveDuration(label){ return saveLabelHit(label, SAVE_DURATION_LABELS); }

// 患者IDの表示加工(+1)。
//   ※ results の中身が「生ID」の場合は、ここで +1 する。
//   ※ もし画面表示の時点で既に +1 済みの値が results に入っているなら、
//      二重加工を防ぐため、この関数は s をそのまま返すように直すこと。
function bumpPatientId(v){
  // 「加工ID」の項目だけに使う。患者IDに+1した数値にする。
  // 0000222415 → 0000222416 のように、先頭のゼロ埋めの桁数はそのまま保つ。
  var s = String(v == null ? "" : v).trim();
  if (s === "") return "";
  if (!/^[0-9]+$/.test(s)) return s;          // 数字だけでなければ触らない
  var n = String(Number(s) + 1);
  while (n.length < s.length) n = "0" + n;    // 元の桁数までゼロで埋め直す
  return n;
}

// 読み取り結果のうち、時間の項目をまとめて h:mm に直す。
// 画面の表示・コピー・台帳への保存がすべて同じ形になる。
function normalizeDurationFields(){
  var items = (curMaster && curMaster.items) || [];
  for (var i = 0; i < items.length; i++){
    var it = items[i];
    if (!isSaveDuration(it.label || "")) continue;
    var key = String(it.no);
    if (results[key] == null || results[key] === "") continue;
    results[key] = normalizeDuration(results[key]);
  }
}

// 「2時間25分」→「2:25」。後から集計しやすい形にそろえる
function normalizeDuration(v){
  var s = String(v == null ? "" : v).trim();
  if (s === "") return "";
  // テンプレートリテラル内ではバックスラッシュが失われるため、正規表現は文字クラスで書く
  var SP = "[ \u3000]*";
  var m = s.match(new RegExp("^([0-9]+)" + SP + "時間" + SP + "(?:([0-9]+)" + SP + "分)?$"));
  if (m) return m[1] + ":" + ("0" + (m[2] || "0")).slice(-2);
  m = s.match(new RegExp("^([0-9]+)" + SP + "分$"));
  if (m) return "0:" + ("0" + m[1]).slice(-2);
  m = s.match(new RegExp("^([0-9]+)" + SP + "[:：]" + SP + "([0-9]{1,2})$"));
  if (m) return m[1] + ":" + ("0" + m[2]).slice(-2);   // 既に h:mm ならゼロ埋めだけ
  return s;                                            // 読めない形はそのまま
}
