// results を保存用ペイロードに整形する。氏名は落とし、加工IDだけ +1 した値にする。
function buildRecordPayload(){
  var items = (curMaster && curMaster.items) || [];
  var fields = [];
  for (var i = 0; i < items.length; i++){
    var it = items[i];
    var label = it.label || String(it.no);
    if (isSaveName(label)) continue;                 // 氏名は保存しない
    var raw = results[String(it.no)];
    raw = (raw == null ? "" : String(raw));
    var val = raw;
    if (isSaveBump(label)) val = bumpPatientId(raw);            // 加工IDだけ +1
    else if (isSaveDuration(label)) val = normalizeDuration(raw);
    fields.push({ no: it.no, label: label, section: (it.section || ""), type: it.type || "", value: val });
  }
  return { fields: fields, materials: (typeof subVals === "object" ? subVals : {}) };
}

function pickPatientNo(){
  var items = (curMaster && curMaster.items) || [];
  for (var i = 0; i < items.length; i++){
    if (isSavePatientId(items[i].label || "")){
      var v = results[String(items[i].no)];
      return (v == null ? "" : String(v).trim());   // B列は読んだままの値
    }
  }
  return "";
}
function pickSurgeryDate(){
  var items = (curMaster && curMaster.items) || [];
  for (var i = 0; i < items.length; i++){
    if (isSaveSurgeryDate(items[i].label || "")){
      var v = results[String(items[i].no)];
      return (v == null ? "" : String(v).trim());
    }
  }
  return "";
}

var _saveTimer = null;
var _saving = false;
function scheduleSave(){
  if (!curMaster) return;                     // 読み取り前(マスタ未確定)は保存しない
  clearTimeout(_saveTimer);
  _saveTimer = setTimeout(doSaveRecord, 1200); // 入力が1.2秒止まったら保存
}
async function doSaveRecord(){
  if (!curMaster || _saving) return;
  _saving = true;
  try {
    var r = await api("/api/record", {
      method: "POST", headers: { "content-type": "application/json" },
      body: JSON.stringify({
        id: currentRecordId,
        file_hash: currentFileHash,
        master_id: (curMaster.id || ""),
        master_name: (curMaster.name || ""),
        patient_no: pickPatientNo(),
        surgery_date: pickSurgeryDate(),
        status: "draft",
        payload: buildRecordPayload()
      })
    });
    if (r && r.id) currentRecordId = r.id;    // 初回INSERTの採番idを保持 → 以後はUPDATE
    setSaveMark(true);
  } catch(e){
    console.warn("台帳への保存に失敗", e);
    setSaveMark(false);
  } finally {
    _saving = false;
  }
}
