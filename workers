// ▼▼ 台帳保存の項目マッピング — 自分のマスタのラベルに合わせて調整 ▼▼
//   下のラベル群は「部分一致」で判定する。実際の用紙のラベル表記に合わせて増減させて。
var SAVE_PATIENT_ID_LABELS   = ["患者ID", "患者ＩＤ", "患者番号", "ID"];   // ← patient_no列(B列)の元。読んだ生の値のまま保存する
var SAVE_BUMP_LABELS         = ["加工ID"];                                 // ← この項目(O列)だけ +1 する
