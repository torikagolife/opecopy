// ファイルの中身から指紋を作る。中身が1バイトでも違えば別の値になる。
// ブラウザの中だけで計算していて、ファイル名も中身も外には送らない。
async function fileHashOf(buf){
  try {
    var digest = await crypto.subtle.digest("SHA-256", buf);
    var arr = Array.prototype.slice.call(new Uint8Array(digest));
    var hex = "";
    for (var i=0;i<arr.length;i++){ hex += ("0" + arr[i].toString(16)).slice(-2); }
    return hex;
  } catch(e){
    return "";   // 使えない環境では指紋なしで動く(今までどおり毎回新規になる)
  }
}

