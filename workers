function outCol(it){
  var t = it.type || "unset";
  if (t === "fixed")   return "[[" + (it.value || "") + "]]";
  if (t === "choice"){
    var cs = splitList(it.choices), o = [];
    for (var i=0;i<cs.length;i++) o.push("[[" + cs[i] + "]]");
    return o.join("or");
  }
  if (t === "sticker") return "シール：確認";
  if (t === "confirm") return "確認";
  return "";
}

function masterToAoa(m){
  var aoa = [["", "【JOANR各種項目】", "出力内容", "(廃止)", "読取り文字", "出力対象", "候補リスト", "材料キーワード", "除外キーワード"]];
  var sec = null;
  var items = m.items || [];
  for (var i=0;i<items.length;i++){
    var it = items[i];
    var s2 = it.section || "";
    if (s2 && s2 !== sec){ sec = s2; aoa.push(["", "【" + s2 + "】", "", "", "", "", "", "", ""]); }
    aoa.push([
      it.no || (i+1),
      it.label || "",
      outCol(it),
      "",
      it.keyword || "",
      it.rule || "",
      it.suggest || "",
      splitList(it.matKeywords).join(","),
      splitList(it.ngKeywords).join(","),
    ]);
  }
  return aoa;
}

function safeSheetName(name, used){
  var bad = [":", String.fromCharCode(92), "/", "?", "*", "[", "]"];
  var s3 = String(name || "sheet");
  for (var i=0;i<bad.length;i++) s3 = s3.split(bad[i]).join("_");
  s3 = s3.slice(0, 28) || "sheet";
  var base = s3, n = 2;
  while (used[s3]){ s3 = (base + "_" + n).slice(0, 31); n++; }
  used[s3] = 1;
  return s3;
}

