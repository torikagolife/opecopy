async function onXlFile(){
  var f = $("xlFile").files[0];
  if (!f) return;
  $("sheetList").innerHTML = '<div class="hint"><span class="spin"></span> 解析中…</div>';
  try {
    await ensureXLSX();
    var buf = await f.arrayBuffer();
    impWb = window.XLSX.read(buf, { type:"array" });
    impParsed = [];
    var names = impWb.SheetNames || [];
    for (var i=0;i<names.length;i++){
      var ws = impWb.Sheets[names[i]];
      var rows = window.XLSX.utils.sheet_to_json(ws, { header:1, defval:"" });
      var items = sheetToItems(rows);
      // 用紙マスタとして読めなかったシートは、氏名リストかどうかを見る
      var docs = items.length ? [] : sheetToDoctors(rows);
      impParsed.push({ sheet: names[i], items: items, doctors: docs });
