// ============================================================
var recRows = [];        // 画面に出ている一覧
var recOffset = 0;
var REC_PAGE = 100;

function recQuery(offset){
  var p = [];
  var pt = $("recQPatient").value.trim();
  var ms = $("recQMaster").value;
  var fr = $("recQFrom").value;
  var to = $("recQTo").value;
  if (pt) p.push("patient=" + encodeURIComponent(pt));
  if (ms) p.push("master=" + encodeURIComponent(ms));
  if (fr) p.push("from=" + encodeURIComponent(fr.replace(/-/g, "/")));
  if (to) p.push("to=" + encodeURIComponent(to.replace(/-/g, "/")));
  p.push("limit=" + REC_PAGE);
  p.push("offset=" + offset);
  return "/api/records?" + p.join("&");
}

async function openRecords(){
  $("recModal").classList.remove("hidden");
  recShowTab(false);
  $("recDetail").classList.add("hidden");
