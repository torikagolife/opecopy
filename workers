var AUTH_KEY = "opecopy_auth";
// サイドバー(拡張のiframe)ではブラウザ設定によりlocalStorageが使えないことがある。
// その場合でもタブを閉じるまでは動くよう、メモリ上にも控えを持つ。
var memAuth = "";
// ログインセッションの控え(Cookieが遮断される環境の保険)
function getSessTok(){
  try { return localStorage.getItem("ope_sess_tok") || ""; } catch(e){ return ""; }
}

function getToken(){
  try { var v = localStorage.getItem(AUTH_KEY); if (v) return v; } catch(e){}
  return memAuth;
}
function setToken(t){ memAuth = t || ""; try { localStorage.setItem(AUTH_KEY, t); } catch(e){} }
function clearToken(){ memAuth = ""; try { localStorage.removeItem(AUTH_KEY); } catch(e){} }

function showLogin(){
  $("loginOverlay").classList.remove("hidden");
  setTimeout(function(){ $("loginPw").focus(); }, 50);
}
function hideLogin(){ $("loginOverlay").classList.add("hidden"); }

async function doLogin(){
  var btn = $("loginBtn");
  var pw = $("loginPw").value;
  if (!pw){ $("loginErr").textContent = "パスワードを入れてね"; return; }
  btn.disabled = true; btn.textContent = "確認中…";
  try {
    var res = await fetch("/api/login", {
      method:"POST", headers:{"content-type":"application/json"},
      body: JSON.stringify({ password: pw })
    });
    var data = await res.json();
    if (!data.ok){ $("loginErr").textContent = data.error || "入れませんでした"; return; }
    setToken(data.token || "");
    $("loginPw").value = "";
    $("loginErr").textContent = "";
    hideLogin();
    afterLogin();
  } catch(e){
    $("loginErr").textContent = "通信に失敗しました";
  } finally {
    btn.disabled = false; btn.textContent = "入る";
  }
}

async function boot(){
  var required = false;
  try {
    var r = await fetch("/api/authinfo");
    var d = await r.json();
    required = !!d.required;
  } catch(e){}
  if (required && !getToken()){ showLogin(); return; }
  afterLogin();
}

