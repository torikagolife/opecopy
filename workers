// ============================================================
// 症例台帳 (D1) — 読み取り結果を恒久保存する
//   バインディング: DB (D1) を Worker に紐付けること
//   テーブル: records (別途 CREATE 済み)
//   ※DB未バインドでも extract 自体は動く。保存の失敗はフロント側でゆるく握りつぶす。
// ============================================================
function recNowIso() { return new Date().toISOString(); }

async function saveRecord(env, body, authUser) {
  if (!env.opecopy_db) return jsonError("D1バインディング opecopy_db が設定されていません", 500);
  const b = body || {};
  let id = b.id ? Number(b.id) : 0;
  const now = recNowIso();
  const fileHash = String(b.file_hash || "").trim();

  // 同じPDFを読み直した場合は、新しい行を作らず前の行を使い回す。
  // (台帳の件数が増えないようにするため。通し番号と最初の読み取り日時も残る)
  if (!id && fileHash) {
    const prev = await env.opecopy_db.prepare(
      "SELECT id FROM records WHERE file_hash=? AND deleted_at IS NULL ORDER BY id DESC LIMIT 1"
    ).bind(fileHash).first();
    if (prev && prev.id) id = Number(prev.id);
  }
  const payload = typeof b.payload === "string" ? b.payload : JSON.stringify(b.payload || {});
  const by = String(authUser || b.by || "");   // BASIC認証のユーザー名を優先する
  const mId = b.master_id || null;
  const mName = b.master_name || null;
  const pNo = b.patient_no || null;
  const sDate = b.surgery_date || null;
  const status = b.status || "draft";

  if (id) {
    // 読み直しのときは、日時も登録者も「最後に読み込んだ人」に更新する
    // (不明点を先輩に引き継いで処理してもらう運用があるため)
    await env.opecopy_db.prepare(
      "UPDATE records SET updated_at=?, updated_by=?, created_by=CASE WHEN ?='' THEN created_by ELSE ? END, master_id=?, master_name=?, patient_no=?, surgery_date=?, status=?, payload=?, file_hash=COALESCE(NULLIF(?,''), file_hash) WHERE id=? AND deleted_at IS NULL"
    ).bind(now, by, by, by, mId, mName, pNo, sDate, status, payload, fileHash, id).run();
    return jsonOk({ id: id, updated: true });
  }
  const res = await env.opecopy_db.prepare(
    "INSERT INTO records (created_at, updated_at, created_by, updated_by, master_id, master_name, patient_no, surgery_date, status, payload, file_hash) VALUES (?,?,?,?,?,?,?,?,?,?,?)"
  ).bind(now, now, by, by, mId, mName, pNo, sDate, status, payload, fileHash || null).run();
  const newId = res && res.meta ? res.meta.last_row_id : null;
  return jsonOk({ id: newId, created: true });
}

// 読み込んだPDFが既に台帳にあるかを、AIに送る前に確かめる
async function findRecordByHash(env, hash) {
  if (!env.opecopy_db) return jsonError("D1バインディング opecopy_db が設定されていません", 500);
  const h = String(hash || "").trim();
  if (!h) return jsonOk({ found: false });
  const row = await env.opecopy_db.prepare(
    "SELECT id, created_at, updated_at, created_by, updated_by, master_name, patient_no, surgery_date FROM records WHERE file_hash=? AND deleted_at IS NULL ORDER BY id DESC LIMIT 1"
  ).bind(h).first();
  if (!row) return jsonOk({ found: false });
  return jsonOk({ found: true, record: row });
}

async function getRecord(env, id) {
  if (!env.opecopy_db) return jsonError("D1バインディング opecopy_db が設定されていません", 500);
  const rid = Number(id);
  if (!rid) return jsonError("idが不正です", 400);
  const row = await env.opecopy_db.prepare(
    "SELECT * FROM records WHERE id=? AND deleted_at IS NULL"
  ).bind(rid).first();
  if (!row) return jsonError("記録が見つかりません", 404);
  return jsonOk({ record: row });
}

async function listRecords(env, params) {
  if (!env.opecopy_db) return jsonError("D1バインディング opecopy_db が設定されていません", 500);
  const p = params || new URLSearchParams();
  const where = ["deleted_at IS NULL"];
  const args = [];
  const patient = (p.get("patient") || "").trim();
  const master = (p.get("master") || "").trim();
  const from = (p.get("from") || "").trim();
  const to = (p.get("to") || "").trim();
  const status = (p.get("status") || "").trim();
  if (patient) { where.push("patient_no LIKE ?"); args.push("%" + patient + "%"); }
  if (master)  { where.push("master_id = ?");     args.push(master); }
  if (from)    { where.push("surgery_date >= ?"); args.push(from); }
  if (to)      { where.push("surgery_date <= ?"); args.push(to); }
  if (status)  { where.push("status = ?");        args.push(status); }
  let limit = parseInt(p.get("limit") || "100", 10);
  if (!(limit > 0) || limit > 1000) limit = 100;
  let offset = parseInt(p.get("offset") || "0", 10);
  if (!(offset >= 0)) offset = 0;
  const sql =
    "SELECT id, created_at, updated_at, created_by, updated_by, master_id, master_name, patient_no, surgery_date, status FROM records WHERE " +
    where.join(" AND ") + " ORDER BY id DESC LIMIT ? OFFSET ?";
  const stmt = env.opecopy_db.prepare(sql);
  const rs = await stmt.bind(...args, limit, offset).all();
  // 一覧は本文(payload)を返さず軽くする。詳細は /api/record?id= で。
  return jsonOk({ records: (rs && rs.results) || [], limit: limit, offset: offset });
}

async function deleteRecord(env, body) {
  if (!env.opecopy_db) return jsonError("D1バインディング opecopy_db が設定されていません", 500);
  const b = body || {};
  const rid = Number(b.id);
  if (!rid) return jsonError("idが不正です", 400);
  const now = recNowIso();
  await env.opecopy_db.prepare(
    "UPDATE records SET deleted_at=?, updated_at=? WHERE id=? AND deleted_at IS NULL"
  ).bind(now, now, rid).run();
  return jsonOk({ id: rid, deleted: true });
}

