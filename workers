// 表示中の一覧をCSVにする。項目は用紙ごとに違うので、出現する項目名を全部列に展開する。
async function exportRecordsCsv(){
  if (!recRows.length){ alert("書き出す症例がありません"); return; }
  var btn = $("recCsv");
  btn.disabled = true;
  var oldLabel = btn.textContent;
  try {
    var fixedCols = ["id","患者ID","手術日","用紙","状態","読取日時","読取者"];
    var labels = [];          // 動的な項目名(出現順)
    var seen = {};
    var rowsOut = [];
    for (var i=0;i<recRows.length;i++){
      btn.textContent = "書き出し中 " + (i+1) + "/" + recRows.length;
      var one = await api("/api/record?id=" + encodeURIComponent(recRows[i].id));
      var rec = one.record || {};
      var pay = {};
      try { pay = JSON.parse(rec.payload || "{}"); } catch(e){}
      var map = {};
      var fs = pay.fields || [];
      for (var f=0;f<fs.length;f++){
        var lb = String(fs[f].label || fs[f].no);
        if (!seen[lb]){ seen[lb] = 1; labels.push(lb); }
        map[lb] = fs[f].value;
      }
      rowsOut.push({ base: [
        rec.id, rec.patient_no || "", rec.surgery_date || "",
        rec.master_name || rec.master_id || "", rec.status || "",
        recFmt(rec.created_at), rec.created_by || ""
      ], map: map });
    }
    var lines = [];
    lines.push(fixedCols.concat(labels).map(csvCell).join(","));
    for (var r2=0;r2<rowsOut.length;r2++){
      var line = rowsOut[r2].base.slice();
      for (var L=0;L<labels.length;L++){
        var v = rowsOut[r2].map[labels[L]];
        line.push(v == null ? "" : v);
      }
      lines.push(line.map(csvCell).join(","));
    }
    // ExcelがUTF-8と分かるようBOMを付ける
    var BOM = String.fromCharCode(65279);   // ExcelがUTF-8と判別できるように
    var blob = new Blob([BOM + lines.join(String.fromCharCode(13) + String.fromCharCode(10))],
      { type: "text/csv;charset=utf-8" });
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "opecopy_records_" + recStamp() + ".csv";
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function(){ URL.revokeObjectURL(a.href); }, 1000);
    toast("CSVを書き出しました");
  } catch(e){
    alert("書き出しに失敗: " + e.message);
  } finally {
    btn.disabled = false;
    btn.textContent = oldLabel;
  }
}

function csvCell(v){
  var s = String(v == null ? "" : v);
  var LF = String.fromCharCode(10), CR = String.fromCharCode(13);
  if (s.indexOf(",") >= 0 || s.indexOf('"') >= 0 || s.indexOf(LF) >= 0 || s.indexOf(CR) >= 0){
    return '"' + s.replace(/"/g, '""') + '"';
  }
  return s;
}

function recStamp(){
  var d = new Date();
  function z(n){ return (n<10?"0":"") + n; }
  return d.getFullYear() + z(d.getMonth()+1) + z(d.getDate()) + "_" + z(d.getHours()) + z(d.getMinutes());
}

