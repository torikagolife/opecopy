async function run(){
  var masterId = $("masterSel").value;
  if (!masterId) return;

  var btn = $("btnRun");
  btn.disabled = true;
  results = {}; labels = []; labelObs = []; assignMap = {}; usedTokens = 0; failedShots = 0; disagree = {}; snapped = {}; kcPicked = {}; doctorInfo = null; subVals = {};
  icdPicked = {};
  currentRecordId = null;
  currentFileHash = "";
  $("resultArea").innerHTML = '<div class="card prog"><span class="spin"></span> <span id="progMsg">準備中…</span></div>';

  try {
    var recPages = [], matPages = [];
    for (var i=0;i<pages.length;i++){
      if (pages[i].role === "rec") recPages.push(pages[i]);
      if (pages[i].role === "mat") matPages.push(pages[i]);
    }

    var doneRec = 0, doneMat = 0, totalMat = 0;
    function prog(){
      var p = [];
      if (recPages.length) p.push("記録面 " + (doneRec ? "読み取り完了" : "読み取り中…"));
      if (totalMat) p.push("シール " + doneMat + "/" + totalMat);
      setProg(p.join("　／　") || "読み取り中…");
    }

    // --- 記録面 ---
    async function jobRecord(){
      if (!recPages.length){
        var mm = await api("/api/master?id=" + encodeURIComponent(masterId));
        curMaster = mm.master;
        for (var f=0; f<curMaster.items.length; f++){
          var itf = curMaster.items[f];
          if (itf.type === "fixed") results[String(itf.no)] = itf.value || "";
        }
        return;
      }
      var imgs = [];
      for (var r=0;r<recPages.length;r++){
        var rbig = await renderPageCanvas(recPages[r], 2400);
        if (SEND_FULL_PAGE) imgs.push({ num: recPages[r].num, image: canvasToDataURL(rbig, 2000, 0.9) });
        if (RECORD_BANDS > 1){
          var bands = tileCanvas(rbig, 1, RECORD_BANDS, RECORD_BAND_OVERLAP, 4000, 0.92);
          for (var b=0;b<bands.length;b++) imgs.push({ num: recPages[r].num, image: bands[b] });
        }
      }
      var ex = await api("/api/extract", {
        method:"POST", headers:{"content-type":"application/json"},
        body: JSON.stringify({ masterId: masterId, pages: imgs })
      });
      results = ex.results || {};
      curMaster = ex.master;
      normalizeDurationFields();   // 手術時間・麻酔時間を 1:33 の形にそろえる
      disagree = ex.disagree || {};
      snapped = ex.snapped || {};
      doctorInfo = ex.doctorInfo || null;
      if (ex.usage && ex.usage.total_tokens) usedTokens += ex.usage.total_tokens;
      doneRec = 1;
    }

    // --- シール面(タイルを並行で読む) ---
    async function jobStickers(){
      for (var m=0;m<matPages.length;m++){
        var big = await renderPageCanvas(matPages[m], 3000);
        var shots = tileCanvas(big, TILE_COLS, TILE_ROWS, TILE_OVERLAP, 2000, 0.92);
        if (TILE_ALSO_FULL) shots.push(canvasToDataURL(big, 2200, 0.9));
        totalMat += shots.length;
        prog();
        var tasks = shots.map(function(img){
          return async function(){
            try {
              var lb = await api("/api/label", {
                method:"POST", headers:{"content-type":"application/json"},
                body: JSON.stringify({ image: img })
              });
              if (lb.usage && lb.usage.total_tokens) usedTokens += lb.usage.total_tokens;
              var arr = lb.items || [];
              for (var z=0;z<arr.length;z++) labelObs.push(arr[z]);
            } catch(err){
              failedShots++;
              console.warn("領域の読み取りに失敗", err);
            }
            doneMat++;
            prog();
          };
        });
        await runPool(tasks, LABEL_CONCURRENCY);
      }
    }

    // 揃った分から画面に出す(記録面が来た時点で一度描画し、シールが揃ったら描き直す)
    function renderPartial(){
      if (!curMaster) return;
      labels = consolidate(labelObs);
      assignStickers();
      buildSubVals();
      renderResults();
      $("stickyBar").classList.remove("hidden");
    }

    prog();
    var pRec = jobRecord().then(function(){ prog(); renderPartial(); });
    var pMat = jobStickers().then(function(){ prog(); });
    await Promise.all([pRec, pMat]);

    renderPartial();
  } catch(e){
    $("resultArea").innerHTML = '<div class="card">読み取りに失敗しました: ' + esc(e.message) + '</div>';
  } finally {
    btn.disabled = false;
    updateRunBtn();
  }
}

function sleep(ms){ return new Promise(function(r){ setTimeout(r, ms); }); }

// 同時実行数を制限しながら並行に走らせる
async function runPool(tasks, limit){
  var out = new Array(tasks.length);
  var next = 0;
  var n = Math.min(Math.max(1, limit), tasks.length);
  var workers = [];
  for (var w=0; w<n; w++){
    workers.push((async function(){
      while (true){
        var my = next++;
        if (my >= tasks.length) break;
        out[my] = await tasks[my]();
      }
    })());
  }
  await Promise.all(workers);
  return out;
}

function setProg(msg){
  var el = $("progMsg");
  if (el) el.textContent = msg;
}

// ============================================================
// 材料シールの割当
//   matKeywords にヒット、かつ ngKeywords に当たらないものを割当
// ============================================================
function assignStickers(){
  assignMap = {};
  var used = {};
  for (var i=0;i<curMaster.items.length;i++){
    var it = curMaster.items[i];
    if (it.type !== "sticker") continue;
    var kws = it.matKeywords || [];
    var ngs = it.ngKeywords || [];
    var hits = [];
    for (var j=0;j<labels.length;j++){
      var t = String(labels[j].title || "").toLowerCase();
      if (!t) continue;
      var hit = false;
      for (var k=0;k<kws.length;k++){
        var kw = String(kws[k]||"").toLowerCase().trim();
        if (kw && t.indexOf(kw) >= 0){ hit = true; break; }
      }
      if (!hit) continue;
      var ng = false;
      for (var n=0;n<ngs.length;n++){
        var nk = String(ngs[n]||"").toLowerCase().trim();
        if (nk && t.indexOf(nk) >= 0){ ng = true; break; }
      }
      if (ng) continue;
      hits.push(j);
      used[j] = true;
    }
    assignMap[String(it.no)] = hits;
  }
  for (var u=0;u<labels.length;u++) labels[u].unassigned = !used[u];
}

// JOANRのコンポーネント入力欄(カタログNo/メーカー名/商品名/ロットNo)に合わせて分解する
function labelToSub(l){
  return { catalog: l.ref || "", maker: l.maker || "", name: l.title || "",
           lot: l.lot || "", sn: l.sn || "", exp: l.exp || "" };
}
function emptySub(){ return { catalog:"", maker:"", name:"", lot:"", sn:"", exp:"" }; }

function buildSubVals(){
  subVals = {};
  var items = (curMaster && curMaster.items) || [];
  for (var i=0;i<items.length;i++){
    var it = items[i];
    if (it.type !== "sticker") continue;
    var no = String(it.no);
    var arr = assignMap[no] || [];
    var list = [];
    for (var a=0;a<arr.length;a++) list.push(labelToSub(labels[arr[a]]));
    if (!list.length) list.push(emptySub());
    subVals[no] = list;
  }
}

function labelText(l){
  var s = l.title || "";
  var meta = [];
  if (l.ref) meta.push("REF " + l.ref);
  if (l.lot) meta.push("LOT " + l.lot);
  if (l.sn)  meta.push("SN " + l.sn);
  if (l.exp) meta.push("EXP " + l.exp);
  if (meta.length) s += "  [" + meta.join(" / ") + "]";
  return s;
}

