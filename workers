async function apiChibaMatch(env, body) {
  const b = body || {};
  const kind = String(b.kind || "");
  if (!chibaKindOk(kind)) return jsonError("種別が不正です", 400);
  const query = String(b.query || "").trim();
  if (!query) return jsonError(chibaLabel(kind) + "を入力してください", 400);
  if (query.length > 200) return jsonError("入力が長すぎます(200文字まで)", 400);
  if (!env.OPENAI_API_KEY) return jsonError("OPENAI_API_KEY が設定されていません", 500);

  const rows = await getChibaList(env, kind);
  const listText = rows.map((r, i) => (i + 1) + ". " + r).join("\n");

  const systemPrompt =
    "あなたは脊椎外科の症例登録に精通した診療情報管理士です。" +
    "手術記録に書かれた" + chibaLabel(kind) + "の表現(略語・英語・表記ゆれ・部位付きの記載を含む)に対し、" +
    "提供された登録リストの中から意味的に近いものを、近い順に最大4件選びます。" +
    "リストに無い語は絶対に返さないでください。リストの表記をそのまま返してください。" +
    "近いものが1件しかなければ1件だけ返して構いません。" +
    "reasonは選定理由を15文字以内で簡潔に。";

  const userPrompt =
    "# 手術記録の記載\n" + query + "\n\n" +
    "# 登録リスト\n" + listText;

  const out = await callOpenAI(
    env, MODEL_KCODE,
    [
      { role: "system", content: systemPrompt },
      { role: "user", content: userPrompt },
    ],
    600, CHIBA_SCHEMA
  );

  // リストに実在する名前だけを残す(幻覚と表記ゆれの防止)
  const valid = new Map();
  for (const r of rows) valid.set(r, true);
  const results = [];
  const used = new Set();
  const raw = (out.json && out.json.results) || [];
  for (const r of raw) {
    const nm = String(r.name || "").trim();
    if (!valid.has(nm) || used.has(nm)) continue;
    used.add(nm);
    results.push({ name: nm, reason: String(r.reason || "") });
    if (results.length >= 4) break;
  }
  if (!results.length) {
    return jsonError("該当する" + chibaLabel(kind) + "が見つかりませんでした。表現を変えて検索してください", 200);
  }
  return jsonOk({ results: results, usage: out.usage || null });
}

