async function saveTemplates(){
  var items = [];
  for (var i=0;i<3;i++){
    var ti = $("tplBody").querySelector('input[data-tpltitle="' + i + '"]');
    var bo = $("tplBody").querySelector('textarea[data-tplbody="' + i + '"]');
    items.push({ title: ti ? ti.value : "", body: bo ? bo.value : "" });
  }
  var btn = $("tplSave");
  btn.disabled = true; btn.textContent = "保存中…";
  try {
    await api("/api/mailtpl", {
      method:"POST", headers:{"content-type":"application/json"},
      body: JSON.stringify({ items: items })
    });
    toast("定型文を保存しました");
  } catch(e){
    alert("保存に失敗: " + e.message);
  } finally {
    btn.disabled = false; btn.textContent = "\uD83D\uDCBE 定型文を保存";
  }
}

