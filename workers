async function apiListUsers(env) {
  if (!env.FORM_KV) return jsonError("KVバインディング FORM_KV が設定されていません", 500);
  const users = await loadUsers(env);
  const list = users.map((u) => ({ id: u.id, name: u.name || "", createdAt: u.createdAt || "" }));
  return jsonOk({ users: list });
}

async function apiSaveUser(env, body) {
  if (!env.FORM_KV) return jsonError("KVバインディング FORM_KV が設定されていません", 500);
  const b = body || {};
  const id = String(b.id || "").trim();
  const pw = String(b.password || "");
  const name = String(b.name || "").trim();
  if (!id) return jsonError("IDを入力してください", 400);
  if (!/^[A-Za-z0-9._-]{2,32}$/.test(id)) {
    return jsonError("IDは半角英数字と . _ - のみ、2〜32文字にしてください", 400);
  }
  if (envStr(env, "MASTER_ID") && id === envStr(env, "MASTER_ID")) {
    return jsonError("このIDは使用できません", 400);
  }
  const users = await loadUsers(env);
  let target = null;
  for (const u of users) if (u.id === id) target = u;

  if (target) {
    if (pw) target.hash = await userHash(id, pw);   // 空なら現状のパスワードを保つ
    target.name = name;
  } else {
    if (!pw) return jsonError("新規登録にはパスワードが必要です", 400);
    if (pw.length < 4) return jsonError("パスワードは4文字以上にしてください", 400);
    users.push({ id: id, name: name, hash: await userHash(id, pw), createdAt: new Date().toISOString() });
  }
  await storeUsers(env, users);
  return jsonOk({ id: id, saved: true });
}

async function apiDeleteUser(env, body) {
  if (!env.FORM_KV) return jsonError("KVバインディング FORM_KV が設定されていません", 500);
  const id = String((body && body.id) || "").trim();
  if (!id) return jsonError("idが不正です", 400);
  const users = await loadUsers(env);
  const left = users.filter((u) => u.id !== id);
  if (left.length === users.length) return jsonError("その利用者は見つかりません", 404);
  await storeUsers(env, left);
  return jsonOk({ id: id, deleted: true });
}

// ============================================================
// パスワード認証 (環境変数 PW_OPE)
//   ・PW_OPE が未設定なら認証なし(自分でロックアウトしないため)
//   ・画面だけでなく /api/* も保護する
//   ・localStorage に入れるのは生パスワードではなくトークン(ハッシュ)
// ============================================================
async function sha256Hex(str) {
  const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(str));
  const arr = new Uint8Array(buf);
  let out = "";
  for (let i = 0; i < arr.length; i++) out += arr[i].toString(16).padStart(2, "0");
  return out;
}

function authRequired(env) {
  return !!(env && env.PW_OPE && String(env.PW_OPE).length > 0);
}

async function authToken(env) {
  return await sha256Hex("opecopy:v1:" + String(env.PW_OPE || ""));
}

async function checkAuth(request, env) {
  if (!authRequired(env)) return true;
  const t = request.headers.get("x-ope-auth") || "";
  if (t && t === (await authToken(env))) return true;
  // 管理画面のCookieでも通す(サイドバー等でヘッダが送れない場合の保険)
  return await readAdminCookie(request, env);
}

async function apiLogin(env, body) {
  if (!authRequired(env)) return jsonOk({ token: "", required: false });
  const pw = String((body && body.password) || "").trim();
  if (!pw || pw !== envStr(env, "PW_OPE")) return jsonError("パスワードが違います", 401);
  // ヘッダ用のトークンに加えて、/admin のページ自体を通すためのCookieも発行する
  const ck = await makeAdminCookie(env);
  return new Response(JSON.stringify({ ok: true, token: await authToken(env), required: true }), {
    status: 200,
    headers: {
      "content-type": "application/json; charset=utf-8",
      "Set-Cookie": adminCookie(ck, ADMIN_HOURS * 3600),
    },
  });
}

// ============================================================
// QR認証
//   PC   : /api/qr/new で発行 → QR表示 → /api/qr/status を監視
//   スマホ: QRのURL /pair?t=トークン を開いた時点で認証成立(保存も登録も無し)
// ============================================================
function qrRequired(env) {
  return !!QR_ENABLED;
}

function randomToken(bytes) {
  const a = new Uint8Array(bytes || 16);
  crypto.getRandomValues(a);
  let out = "";
  for (let i = 0; i < a.length; i++) out += a[i].toString(16).padStart(2, "0");
  return out;
}

// 目視照合用の6桁(000000〜999999)。これは鍵ではない
function random6() {
  const a = new Uint32Array(1);
  crypto.getRandomValues(a);
  return String(a[0] % 1000000).padStart(6, "0");
}

function cleanToken(t) {
  const str = String(t || "").toLowerCase();
  let out = "";
  for (let i = 0; i < str.length && out.length < 64; i++) {
    const c = str.charAt(i);
    if ((c >= "0" && c <= "9") || (c >= "a" && c <= "f")) out += c;
  }
  return out;
}

async function apiQrNew(env) {
  if (!qrRequired(env)) return jsonOk({ required: false });
  if (!env.FORM_KV) return jsonError("KVバインディング FORM_KV が設定されていません", 500);
  const token = randomToken(20);       // QRに入る実際の鍵(40文字)
  const code = random6();              // 画面に出す目視確認用の番号
  // このキーを読むのはスマホだけ。PCは読まない（読むとキャッシュされて後の変化が見えなくなる）
  await env.FORM_KV.put(
    "qr:" + token,
    JSON.stringify({ code: code, createdAt: Date.now() }),
    { expirationTtl: Math.max(60, QR_TTL_SEC) }
  );
  return jsonOk({ token: token, code: code, ttl: QR_TTL_SEC });
}

// ▼▼ KVのキャッシュ対策（重要） ▼▼
//   KVは「読んだ結果」を各拠点で最低30〜60秒キャッシュする。
//   キーが無いという結果もキャッシュされるため、PCが2秒ごとに同じキーを読むと
//   最初の「まだ承認されていない」がキャッシュされ、スマホが承認しても気づけない。
//   そこで10秒ごとに違うキー(スロット)を読むようにする。
//   一度も読んでいないキーはキャッシュが無いので、必ず最新の状態を取りに行く。
//   スマホ側は承認時に、これから10秒ごとに読まれる分のスロットへまとめて書いておく。
function slotNow() { return Math.floor(Date.now() / (QR_SLOT_SEC * 1000)); }
function slotKey(token, n) { return "qrp:" + token + ":" + n; }
// ▲▲ ここまで ▲▲

async function apiQrStatus(env, token) {
  if (!qrRequired(env)) return jsonOk({ status: "off" });
  const t = cleanToken(token);
  if (!t) return jsonError("コードが不正です", 400);

  // スロットはサーバー側で決める（PCの時計がずれていても影響しない）
  const raw = await env.FORM_KV.get(slotKey(t, slotNow()));
  if (!raw) return jsonOk({ status: "waiting" });
  let o;
  try { o = JSON.parse(raw); } catch (e) { return jsonOk({ status: "waiting" }); }
  return jsonOk({ status: "approved", session: o.session || "" });
}

// スマホがURLを開いた時点で認証成立。端末登録もPINも要求しない
async function apiQrApprove(env, body) {
  if (!qrRequired(env)) return jsonError("QR認証は無効です", 400);
  if (!env.FORM_KV) return jsonError("KVバインディング FORM_KV が設定されていません", 500);

  const t = cleanToken(body && body.token);
  if (!t) return jsonError("コードが不正です", 400);

  const raw = await env.FORM_KV.get("qr:" + t);
  if (!raw) return jsonError("このQRは期限切れです。PCの画面で新しいQRを表示してください。", 400);

  let o;
  try { o = JSON.parse(raw); } catch (e) { return jsonError("このQRは使用できません", 400); }

  // 既に承認済みなら同じセッションを返す（スマホでリロードしてもエラーにしない）
  let session = o.session;
  if (!session) {
    session = randomToken(24);
    await env.FORM_KV.put("qrs:" + session, JSON.stringify({ approvedAt: Date.now() }),
      { expirationTtl: Math.max(60, QR_SESSION_HOURS * 3600) });
    await env.FORM_KV.put("qr:" + t, JSON.stringify({ code: o.code || "", session: session }),
      { expirationTtl: Math.max(60, QR_TTL_SEC) });
  }

  // これからPCが読みにくるスロットへ、まとめて置いておく
  const body2 = JSON.stringify({ session: session });
  const base = slotNow();
  const jobs = [];
  for (let i = 0; i < QR_SLOT_COUNT; i++) {
    jobs.push(env.FORM_KV.put(slotKey(t, base + i), body2,
      { expirationTtl: Math.max(60, QR_SLOT_SEC * QR_SLOT_COUNT + 60) }));
  }
  await Promise.all(jobs);

  return jsonOk({ approved: true, code: o.code || "", hours: QR_SESSION_HOURS });
}

async function checkQrSession(request, env) {
  if (!qrRequired(env)) return true;          // 無効設定なら素通り
